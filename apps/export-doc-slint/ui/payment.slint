import { ComboBox, LineEdit } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, ActionButton, Badge, Card } from "theme.slint";
import { FormSections } from "forms.slint";
import { PdfView } from "pdf.slint";

export component PaymentPage inherits FocusScope {
    key-pressed(event) => {
        if ((event.modifiers.control || event.modifiers.meta) && event.text == "s") {
            App.payment-action("save"); return accept;
        }
        return reject;
    }
    VerticalLayout { padding:0px; spacing:12px;
        HorizontalLayout {height:36px;spacing:8px;
            ActionButton{text:"← 返回列表";enabled:!App.busy;clicked=>{App.payment-action("back");}}
            Rectangle{horizontal-stretch:1;}
            Badge{text:App.payment-dirty?"尚未保存":App.payment-saved?"已保存":"新建付款报销";}
            if !App.payment-editable:Badge{text:"只读";}
        }
        Card {height:124px;
            VerticalLayout{padding:12px;spacing:8px;
                HorizontalLayout{height:36px;spacing:10px;
                    VerticalLayout{padding:0px;spacing:4px;
                        Text{text:App.payment-title;color:Theme.ink;font-weight:700;font-size:14px;}
                        Text{text:App.payment-summary;color:Theme.muted;font-size:12px;}
                    }
                    Rectangle{horizontal-stretch:1;}
                    ActionButton{text:"重新加载";enabled:App.payment-saved&&!App.busy;clicked=>{App.payment-action("reload");}}
                    if App.payment-editable:ActionButton{text:"保存付款报销";primary:true;enabled:!App.busy;clicked=>{App.payment-action("save");}}
                }
                HorizontalLayout{height:34px;spacing:6px;alignment:start;
                    for tab[index] in ["基本信息","业务信息","金额与费用","预览与导出"]:ActionButton{
                        text:tab;active:App.payment-tab==index;enabled:!App.busy;clicked=>{App.payment-tab-changed(index);}
                    }
                }
                Text{text:App.payment-tab==0?"填写付款单号与日期，选择收款方及付款方式。":App.payment-tab==1?"填写本次付款的货物、数量和业务资料，备用字段按需展开。":App.payment-tab==2?"填写付款金额和各项费用，费用合计自动汇入人民币金额。":"选择付款模板，核对当前草稿并生成凭证。";color:Theme.muted;font-size:12px;}
            }
        }
        if App.payment-error!="":Text{text:App.payment-error;color:Theme.error;wrap:word-wrap;min-height:28px;accessible-live-region:assertive;}
        Card {vertical-stretch:1;
            if App.payment-tab<3:VerticalLayout{padding:10px;spacing:6px;
                if App.payment-tab==0:HorizontalLayout{height:36px;spacing:12px;alignment:start;
                    Text{text:"账号类型";color:Theme.muted;vertical-alignment:center;}
                    ComboBox{model:["人民币账号","美金账号"];current-index<=>App.payment-account-index;enabled:App.payment-editable&&!App.busy;selected=>{App.payment-action("account");}}
                }
                FormSections{sections:App.payment-sections;editable:App.payment-editable;enabled:!App.busy;invalid-key:App.payment-invalid-field;
                    toggled(key)=>{App.toggle-form-section(key);}
                    edited(key,value)=>{App.payment-field-edited(key,value);}
                    selected(key,index)=>{App.payment-field-selected(key,index);}
                }
                if App.payment-tab==0&&App.payment-editable:HorizontalLayout{height:36px;spacing:8px;
                    Text{text:"新增付款方式";color:Theme.muted;vertical-alignment:center;}
                    LineEdit{text<=>App.payment-new-method;placeholder-text:"输入新的付款方式";enabled:!App.busy;horizontal-stretch:1;accepted=>{App.payment-action("add-method");}}
                    ActionButton{text:"添加并选择";enabled:!App.busy&&App.payment-new-method!="";clicked=>{App.payment-action("add-method");}}
                }
            }
            if App.payment-tab==3:PdfView{}
        }
    }
}
