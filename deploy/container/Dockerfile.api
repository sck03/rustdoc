# syntax=docker/dockerfile:1.7

FROM node:24-trixie-slim AS report-fonts
WORKDIR /src
COPY scripts/provision-report-fonts.mjs scripts/verify-font-license-policy.mjs scripts/
COPY Resources/Fonts/OpenSource/font-manifest.json Resources/Fonts/OpenSource/OFL-Noto-CJK.txt Resources/Fonts/OpenSource/README.md Resources/Fonts/OpenSource/
RUN node scripts/provision-report-fonts.mjs \
    && node scripts/verify-font-license-policy.mjs --require-files

FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1
RUN dotnet --version | grep -Eq '^10\.0\.[0-9]+$'
WORKDIR /src
ARG TARGETARCH

# The OCR sidecar loads the ONNX native library from the managed publish
# output. Restore and publish for the target Linux RID explicitly; a portable
# publish would omit libonnxruntime.so and make the runtime OCR probe fail.
RUN case "$TARGETARCH" in \
        amd64) echo linux-x64 > /tmp/exportdoc-runtime-id ;; \
        arm64) echo linux-arm64 > /tmp/exportdoc-runtime-id ;; \
        *) echo "Unsupported Docker target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac

COPY global.json Directory.Build.props Directory.Packages.props NuGet.Config version.json ./
COPY eng/nuget-runtime-locks/ eng/nuget-runtime-locks/
COPY src/ExportDocManager.Domain/ExportDocManager.Domain.csproj src/ExportDocManager.Domain/
COPY src/ExportDocManager.Application/ExportDocManager.Application.csproj src/ExportDocManager.Application/
COPY src/ExportDocManager.Infrastructure/ExportDocManager.Infrastructure.csproj src/ExportDocManager.Infrastructure/
COPY src/ExportDocManager.Infrastructure.Excel/ExportDocManager.Infrastructure.Excel.csproj src/ExportDocManager.Infrastructure.Excel/
COPY src/ExportDocManager.Infrastructure.Browser/ExportDocManager.Infrastructure.Browser.csproj src/ExportDocManager.Infrastructure.Browser/
COPY src/ExportDocManager.Infrastructure.PdfOcr/ExportDocManager.Infrastructure.PdfOcr.csproj src/ExportDocManager.Infrastructure.PdfOcr/
COPY src/ExportDocManager.Api/ExportDocManager.Api.csproj src/ExportDocManager.Api/
RUN --mount=type=cache,id=exportdoc-nuget-${TARGETARCH},target=/root/.nuget/packages,sharing=locked \
    runtime_identifier="$(cat /tmp/exportdoc-runtime-id)" \
    && dotnet restore src/ExportDocManager.Api/ExportDocManager.Api.csproj \
        --locked-mode \
        --configfile NuGet.Config \
        /p:RuntimeIdentifier="$runtime_identifier" \
        /p:ExportDocRuntimeRestore=true \
        /p:ExportDocPackageProfile=Container

COPY src/ src/
COPY Shared/ Shared/
COPY Templates/ Templates/
COPY Resources/ Resources/
COPY --from=report-fonts /src/Resources/Fonts/OpenSource/ Resources/Fonts/OpenSource/
COPY OcrModels/ OcrModels/
RUN --mount=type=cache,id=exportdoc-nuget-${TARGETARCH},target=/root/.nuget/packages,sharing=locked \
    runtime_identifier="$(cat /tmp/exportdoc-runtime-id)" \
    && dotnet publish src/ExportDocManager.Api/ExportDocManager.Api.csproj \
    --configuration Release \
    --runtime "$runtime_identifier" \
    --no-restore \
    --output /out \
    /p:UseAppHost=false \
    /p:ExportDocRuntimeRestore=true \
    /p:ExportDocPackageProfile=Container \
    && find src -type d \( -name bin -o -name obj \) -prune -exec rm -rf -- {} +

FROM rust:1.96-trixie AS ocr-build
WORKDIR /src
ARG TARGETARCH
COPY apps/exportdoc-ocr-rs/Cargo.toml apps/exportdoc-ocr-rs/Cargo.lock ./
COPY apps/exportdoc-ocr-rs/src/ ./src/
RUN --mount=type=cache,id=exportdoc-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=exportdoc-cargo-git-${TARGETARCH},target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=exportdoc-ocr-target-${TARGETARCH},target=/src/target,sharing=locked \
    cargo build --release --locked \
    && install -Dm755 /src/target/release/exportdoc-ocr /out/exportdoc-ocr

FROM rust:1.96-trixie AS excel-analyzer-build
WORKDIR /src
ARG TARGETARCH
COPY tools/excel-analyzer-rs/Cargo.toml tools/excel-analyzer-rs/Cargo.lock ./
COPY tools/excel-analyzer-rs/src/ ./src/
RUN --mount=type=cache,id=exportdoc-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=exportdoc-cargo-git-${TARGETARCH},target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=exportdoc-excel-target-${TARGETARCH},target=/src/target,sharing=locked \
    cargo build --release --locked \
    && install -Dm755 /src/target/release/exportdoc-excel-analyzer /out/exportdoc-excel-analyzer

FROM debian:trixie-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgomp1 \
        libunwind8 \
        tini \
        tzdata \
        zlib1g \
    && curl --fail --silent --show-error --location --output /tmp/packages-microsoft-prod.deb \
        https://packages.microsoft.com/config/debian/13/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && curl --fail --silent --show-error --location --output /usr/share/keyrings/postgresql.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        aspnetcore-runtime-10.0 \
        dotnet-host \
        dotnet-hostfxr-10.0 \
        dotnet-runtime-10.0 \
        dotnet-runtime-deps-10.0 \
        postgresql-client-18 \
    && aspnet_version="$(dotnet --list-runtimes | awk '$1 == "Microsoft.AspNetCore.App" && $2 ~ /^10\.0\.[0-9]+$/ { print $2; exit }')" \
    && netcore_version="$(dotnet --list-runtimes | awk '$1 == "Microsoft.NETCore.App" && $2 ~ /^10\.0\.[0-9]+$/ { print $2; exit }')" \
    && test -n "$aspnet_version" \
    && test "$aspnet_version" = "$netcore_version" \
    && pg_dump --version | grep -F '18.' \
    && dpkg --purge packages-microsoft-prod \
    && rm -rf \
        /var/lib/apt/lists/* \
        /tmp/packages-microsoft-prod.deb \
        /etc/apt/sources.list.d/microsoft-prod.list \
        /etc/apt/sources.list.d/pgdg.list \
        /usr/share/keyrings/microsoft-prod.gpg \
        /usr/share/keyrings/postgresql.asc

WORKDIR /app
RUN groupadd --system --gid 10001 exportdoc \
    && useradd --system --uid 10001 --gid 10001 --home-dir /runtime-data --no-create-home exportdoc \
    && install -d -o 10001 -g 10001 -m 0750 /runtime-data
COPY --from=build /out/ ./
COPY --from=ocr-build /out/exportdoc-ocr ./sidecar/ocr/exportdoc-ocr
COPY --from=excel-analyzer-build /out/exportdoc-excel-analyzer ./Tools/exportdoc-excel-analyzer
COPY tools/excel-analyzer-rs/THIRD_PARTY_NOTICES.md ./Tools/EXCEL_ANALYZER_NOTICES.md
COPY apps/exportdoc-ocr-rs/README.md ./sidecar/ocr/README.md
COPY THIRD_PARTY_NOTICES.md THIRD_PARTY_DEPENDENCIES.md ./Legal/
ARG TARGETARCH
ENV ASPNETCORE_URLS=http://0.0.0.0:5188 \
    HOME=/runtime-data \
    EXPORTDOCMANAGER_DATA_ROOT=/runtime-data \
    EXPORTDOCMANAGER_NETWORK_MODE=true \
    EXPORTDOCMANAGER_PRODUCT_EDITION=Full \
    EXPORTDOCMANAGER_OCR_RUNTIME=enabled \
    EXPORTDOCMANAGER_POSTGRES_BIN=/usr/lib/postgresql/18/bin \
    TZ=Asia/Shanghai
RUN set -- /app/.playwright/node/linux-*/node \
    && test "$#" -eq 1 \
    && playwright_node="$1" \
    && test -f "$playwright_node" \
    && test -s /app/libonnxruntime.so \
    && test -s /app/OcrModels/PaddleOCR/V6/det/inference.onnx \
    && test -s /app/OcrModels/PaddleOCR/V6/rec/inference.onnx \
    && test -s /app/OcrModels/PaddleOCR/V6/rec/inference.yml \
    && chmod 0755 \
        "$playwright_node" \
        /app/sidecar/ocr/exportdoc-ocr \
        /app/Tools/exportdoc-excel-analyzer \
    && "$playwright_node" --version
USER 10001:10001
EXPOSE 5188
ENTRYPOINT ["/usr/bin/tini", "--", "dotnet", "ExportDocManager.Api.dll"]
