import { ScrollView, LineEdit } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, Card, ActionButton, Badge } from "theme.slint";

export component OrganizationPage inherits Rectangle {
    background:transparent;
    VerticalLayout {padding:0px;spacing:12px;
        HorizontalLayout {height:36px;spacing:10px;
            Text{text:"公司与部门";color:Theme.ink;font-size:20px;font-weight:700;vertical-alignment:center;horizontal-stretch:1;}
            ActionButton{text:"人员档案";clicked=>{App.navigate("people");}}
            ActionButton{text:"＋ 新增公司";primary:true;enabled:!App.busy&&App.can-create;clicked=>{App.organization-action("new-company","");}}
        }
        HorizontalLayout {spacing:14px;
            Card {width:220px;VerticalLayout{padding:12px;spacing:10px;
                Text{text:"公司目录";color:Theme.muted;font-size:13px;height:24px;}
                ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:8px;alignment:start;
                    for company in App.org-companies:ActionButton{text:company.label;left-aligned:true;active:company.key==App.org-company-code;enabled:!App.busy;clicked=>{App.organization-action("company",company.key);}}
                }}
            }}
            Card {VerticalLayout{padding:16px;spacing:12px;
                HorizontalLayout{height:36px;spacing:8px;
                    Text{text:App.org-company-name;color:Theme.ink;font-size:18px;font-weight:700;vertical-alignment:center;horizontal-stretch:1;}
                    Badge{text:App.org-company-active?"启用":"停用";}
                    ActionButton{text:"编辑公司";enabled:!App.busy&&App.can-edit&&App.org-company-code!="";clicked=>{App.organization-action("edit-company",App.org-company-code);}}
                    ActionButton{text:"删除公司";enabled:!App.busy&&App.can-delete&&App.org-company-code!="";clicked=>{App.organization-action("delete-company",App.org-company-code);}}
                }
                Text{text:App.org-summary;color:Theme.muted;font-size:12px;height:22px;}
                HorizontalLayout{height:36px;spacing:8px;
                    LineEdit{text<=>App.org-search;input-type:InputType.search;placeholder-text:"查找部门名称、代码或负责人";accessible-label:"查找部门或负责人";horizontal-stretch:1;edited=>{App.organization-search(self.text);}}
                    ActionButton{text:"刷新";enabled:!App.busy;clicked=>{App.refresh();}}
                    ActionButton{text:"＋ 新增部门";primary:true;enabled:!App.busy&&App.can-create&&App.org-company-active;clicked=>{App.organization-action("new-department","");}}
                }
                HorizontalLayout{height:32px;spacing:8px;
                    Text{text:"部门层级";color:Theme.ink;font-weight:700;vertical-alignment:center;horizontal-stretch:1;}
                    for label[index] in ["仅看一级","展开两级","全部展开"]:ActionButton{text:label;enabled:App.org-search=="";clicked=>{App.organization-action("depth",index+"");}}
                }
                Rectangle{height:34px;background:Theme.soft;
                    HorizontalLayout{padding-left:12px;padding-right:12px;spacing:12px;
                        Text{text:"部门 / 代码";color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
                        Text{text:"负责人";color:Theme.muted;width:100px;vertical-alignment:center;}
                        Text{text:"状态";color:Theme.muted;width:45px;vertical-alignment:center;}
                        Text{text:"操作";color:Theme.muted;width:180px;vertical-alignment:center;}
                    }
                }
                ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:0px;
                    for row in App.org-rows:Rectangle{
                        height:56px;background:App.org-selected==row.code?Theme.soft:white;
                        Rectangle{y:55px;height:1px;background:Theme.line;}
                        HorizontalLayout{padding:6px;spacing:12px;
                            HorizontalLayout{spacing:6px;padding-left:min(row.depth,6)*16px;horizontal-stretch:1;
                                ActionButton{text:row.children==0?"·":row.expanded?"▾":"▸";min-width:28px;max-width:28px;enabled:row.children>0&&App.org-search=="";clicked=>{App.organization-action("toggle",row.code);}}
                                Rectangle{horizontal-stretch:1;min-width:80px;
                                    VerticalLayout{spacing:4px;padding:0px;
                                        Text{text:row.name;color:Theme.ink;font-size:13px;font-weight:600;overflow:elide;}
                                        Text{text:row.code+(row.depth>=6?" · 第 "+(row.depth+1)+" 级":"");color:Theme.muted;font-size:11px;overflow:elide;}
                                    }
                                    TouchArea{mouse-cursor:pointer;clicked=>{App.organization-action("select",row.code);}double-clicked=>{App.organization-action("edit-department",row.code);}}
                                }
                            }
                            Text{text:row.manager==""?"未设置":row.manager;color:Theme.muted;width:100px;vertical-alignment:center;overflow:elide;}
                            Text{text:row.active?"启用":"停用";color:row.active?Theme.primary:Theme.muted;width:45px;vertical-alignment:center;}
                            HorizontalLayout{width:180px;spacing:4px;
                                ActionButton{text:"编辑";enabled:!App.busy&&App.can-edit;clicked=>{App.organization-action("edit-department",row.code);}}
                                ActionButton{text:"＋下级";enabled:!App.busy&&App.can-create&&App.org-company-active&&row.active;clicked=>{App.organization-action("new-department",row.code);}}
                                ActionButton{text:"删除";enabled:!App.busy&&App.can-delete;clicked=>{App.organization-action("delete-department",row.code);}}
                            }
                        }
                    }
                    if App.org-rows.length==0:Text{text:App.org-search!=""?"没有符合条件的部门":"该公司尚未设置部门";color:Theme.muted;horizontal-alignment:center;height:120px;}
                }}
                Text{text:App.org-selected-path==""?"点击部门名称查看完整路径和负责人。":App.org-selected-path;color:Theme.muted;font-size:12px;wrap:word-wrap;min-height:36px;}
            }}
        }
    }
}
