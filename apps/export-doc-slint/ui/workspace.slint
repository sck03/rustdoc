import { ScrollView, ComboBox } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, Card, ActionButton } from "theme.slint";

export component WorklistPage inherits Rectangle {
    background:transparent;
    VerticalLayout{padding:0px;spacing:14px;
        HorizontalLayout{height:36px;spacing:12px;
            Text{text:"按业务来源分组，进入业务办理后自动更新。";color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
            ActionButton{text:"刷新";enabled:!App.busy;clicked=>{App.refresh();}}
        }
        Card{VerticalLayout{padding:16px;spacing:14px;
            HorizontalLayout{height:36px;spacing:12px;alignment:start;
                Text{text:"事项来源";color:Theme.muted;vertical-alignment:center;}
                ComboBox{model:App.worklist-sources;current-index<=>App.worklist-source-index;accessible-label:"事项来源";width:240px;enabled:!App.busy;selected(value)=>{App.refresh();}}
                Text{text:"到期筛选";color:Theme.muted;vertical-alignment:center;}
                ComboBox{model:["全部待办","已到期","未来 30 天","未设截止日期"];current-index<=>App.worklist-due-index;accessible-label:"到期筛选";width:180px;enabled:!App.busy;selected(value)=>{App.refresh();}}
            }
            ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:10px;alignment:start;
                for item in App.worklist-rows:Card{height:112px;
                    HorizontalLayout{padding:16px;spacing:16px;
                        VerticalLayout{spacing:8px;horizontal-stretch:1;
                            Text{text:item.source;color:Theme.muted;font-size:12px;overflow:elide;}
                            Text{text:item.title;color:Theme.ink;font-size:16px;font-weight:700;overflow:elide;}
                            Text{text:item.description;color:Theme.muted;font-size:13px;overflow:elide;}
                        }
                        VerticalLayout{spacing:10px;alignment:center;width:235px;
                            Text{text:(item.overdue?"已到期 · ":"")+item.due;color:item.overdue?Theme.error:Theme.muted;font-size:12px;horizontal-alignment:right;overflow:elide;}
                            ActionButton{text:"查看并处理";enabled:!App.busy;clicked=>{App.worklist-open(item.index);}}
                        }
                    }
                }
                if App.worklist-rows.length==0:Text{text:App.busy?"正在读取待办…":"当前没有符合条件的待办";color:Theme.muted;height:150px;horizontal-alignment:center;}
            }}
            HorizontalLayout{height:36px;spacing:8px;
                Text{text:App.worklist-as-of+" · 共 "+App.total-records+" 项";color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
                ActionButton{text:"上一页";enabled:!App.busy&&App.list-page>1;clicked=>{App.change-page(-1);}}
                Text{text:App.list-page+" / "+max(App.total-pages,1);color:Theme.muted;vertical-alignment:center;}
                ActionButton{text:"下一页";enabled:!App.busy&&App.list-page<App.total-pages;clicked=>{App.change-page(1);}}
            }
        }}
    }
}

export component DashboardPage inherits Rectangle {
    background:transparent;
    in property <int> metric-columns:root.width>1240px?6:3;
    VerticalLayout{padding:0px;spacing:14px;
        HorizontalLayout{height:36px;spacing:10px;
            Text{text:App.dashboard-summary;color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
            Text{text:"统计周期："+App.dashboard-period;color:Theme.muted;vertical-alignment:center;}
            ActionButton{text:"刷新";enabled:!App.busy;clicked=>{App.refresh();}}
        }
        for row in ceil(App.metrics.length/root.metric-columns):HorizontalLayout{height:120px;spacing:12px;
            for column in root.metric-columns:Card{horizontal-stretch:1;
                in property <int> index:row*root.metric-columns+column;
                VerticalLayout{padding:15px;spacing:10px;
                    Text{text:App.metrics[row*root.metric-columns+column].label;color:Theme.muted;font-size:13px;overflow:elide;}
                    Text{text:App.metrics[row*root.metric-columns+column].value;color:Theme.primary;font-size:25px;font-weight:700;overflow:elide;}
                    Text{text:App.dashboard-details[row*root.metric-columns+column];color:Theme.muted;font-size:11px;overflow:elide;}
                }
            }
        }
        HorizontalLayout{height:38px;spacing:10px;alignment:start;
            for action in App.dashboard-quick:ActionButton{text:action.label;enabled:!App.busy;clicked=>{App.dashboard-action(action.key);}}
        }
        HorizontalLayout{spacing:14px;
            Card{horizontal-stretch:2;VerticalLayout{padding:16px;spacing:12px;
                Text{text:"近期单据";color:Theme.ink;font-size:17px;font-weight:700;height:26px;}
                Rectangle{height:36px;background:Theme.soft;HorizontalLayout{padding:8px;spacing:10px;for column in App.columns:Text{text:column;color:Theme.muted;font-size:12px;horizontal-stretch:1;vertical-alignment:center;}}}
                ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:0px;
                    for row in App.records:Rectangle{height:48px;background:white;
                        Rectangle{y:47px;height:1px;background:Theme.line;}
                        HorizontalLayout{padding:8px;spacing:10px;for cell in row.cells:Text{text:cell;color:Theme.ink;font-size:12px;horizontal-stretch:1;vertical-alignment:center;overflow:elide;}}
                        TouchArea{mouse-cursor:pointer;double-clicked=>{App.dashboard-action(row.id+"");}}
                    }
                    if App.records.length==0:Text{text:"尚无单据，可从新建发票开始。";color:Theme.muted;horizontal-alignment:center;height:140px;}
                }}
            }}
            Card{horizontal-stretch:1;max-width:345px;VerticalLayout{padding:16px;spacing:12px;
                Text{text:"单据待办";color:Theme.ink;font-size:17px;font-weight:700;height:26px;}
                ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:10px;alignment:start;
                    for item in App.dashboard-todos:Rectangle{height:91px;background:Theme.soft;border-radius:6px;
                        Text{x:12px;y:10px;width:parent.width - 24px;height:parent.height - 20px;text:item.label;color:Theme.ink;font-size:13px;wrap:word-wrap;}
                        TouchArea{mouse-cursor:pointer;clicked=>{App.dashboard-action(item.key);}}
                    }
                    if App.dashboard-todos.length==0:Text{text:"当前没有需要处理的单据";color:Theme.muted;wrap:word-wrap;height:100px;}
                }}
            }}
        }
    }
}
