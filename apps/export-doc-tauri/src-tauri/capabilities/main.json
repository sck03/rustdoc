{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-desktop",
  "description": "Allow the main ExportDocManager desktop window to use Tauri IPC and desktop bridge commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "allow-desktop-bridge"
  ]
}
