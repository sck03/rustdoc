import { LineEdit, ComboBox } from "std-widgets.slint";
import { App } from "models.slint";
import { Recovery } from "recovery-models.slint";
import { Theme, Card, ActionButton } from "theme.slint";

component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height:26px;
    HorizontalLayout {spacing:10px;
        Text{text:label;color:Theme.muted;width:104px;vertical-alignment:center;}
        Text{text:value;color:Theme.ink;horizontal-stretch:1;vertical-alignment:center;overflow:elide;}
    }
}

export component DisasterRecoveryPanel inherits Rectangle {
    background:transparent;
    VerticalLayout {padding:0px;spacing:14px;
        Card {VerticalLayout {padding:16px;spacing:10px;
            Text{text:"持卡机灾难恢复";font-size:15px;font-weight:700;color:Theme.ink;height:26px;}
            Text{text:Recovery.supported?(Recovery.pending-restore?"恢复任务已排队，重启后生效。":"独立加密包用于整机损坏或更换持卡机，不等同于普通数据库备份。"):"当前运行模式不支持灾备包。";color:Recovery.pending-restore?Theme.error:Theme.muted;wrap:word-wrap;font-size:12px;min-height:32px;}
            DetailRow {label:"恢复包目录";value:Recovery.recovery-root;}
            DetailRow {label:"状态说明";value:Recovery.message;}
            Text{text:Recovery.storage-policy;color:Theme.muted;wrap:word-wrap;font-size:12px;min-height:44px;}
        }}
        Card {VerticalLayout {padding:16px;spacing:10px;
            Text{text:"创建加密恢复包";font-size:15px;font-weight:700;color:Theme.ink;height:26px;}
            HorizontalLayout {height:38px;spacing:10px;
                LineEdit {text <=> Recovery.password;input-type:InputType.password;placeholder-text:"新密码（至少 12 位）";accessible-label:"新恢复包密码";horizontal-stretch:1;enabled:!App.busy&&Recovery.supported;}
                LineEdit {text <=> Recovery.password-confirm;input-type:InputType.password;placeholder-text:"再次输入密码";accessible-label:"确认恢复包密码";horizontal-stretch:1;enabled:!App.busy&&Recovery.supported;}
                ActionButton{text:"创建加密恢复包";primary:true;enabled:!App.busy&&Recovery.can-create;clicked=>{Recovery.action("create");}}
            }
        }}
        Card {VerticalLayout {padding:16px;spacing:10px;
            Text{text:"恢复灾备包";font-size:15px;font-weight:700;color:Theme.ink;height:26px;}
            HorizontalLayout {height:38px;spacing:10px;
                LineEdit {text <=> Recovery.package-path;placeholder-text:"请选择 .edmrecovery 文件";accessible-label:"待恢复灾备包";read-only:true;horizontal-stretch:1;enabled:!App.busy;}
                ActionButton{text:"选择恢复包";enabled:!App.busy&&Recovery.supported;clicked=>{Recovery.action("choose");}}
            }
            HorizontalLayout {height:38px;spacing:10px;
                LineEdit {text <=> Recovery.restore-password;input-type:InputType.password;placeholder-text:"恢复包密码";accessible-label:"恢复包密码";horizontal-stretch:1;enabled:!App.busy&&Recovery.package-path!="";}
                LineEdit {text <=> Recovery.restore-confirmation;placeholder-text:"RECOVER";accessible-label:"恢复确认文本";width:130px;enabled:!App.busy&&Recovery.package-path!="";}
                ActionButton{text:"安排灾难恢复";enabled:!App.busy&&Recovery.can-restore;clicked=>{Recovery.action("restore");}}
            }
            Text{text:"恢复会替换当前数据并要求重新登录；恢复包不携带许可证或机器绑定，恢复后必须按当前机器码重新激活。";color:Theme.muted;wrap:word-wrap;font-size:12px;min-height:32px;}
        }}
        Card {VerticalLayout {padding:16px;spacing:10px;
            Text{text:"云端备份（WebDAV）";font-size:15px;font-weight:700;color:Theme.ink;height:26px;}
            Text{text:Recovery.cloud-summary;color:Recovery.cloud-configured?Theme.ink:Theme.muted;wrap:word-wrap;font-size:12px;min-height:32px;}
            DetailRow {label:"服务地址";value:Recovery.cloud-url;}
            DetailRow {label:"账号";value:Recovery.cloud-user;}
            DetailRow {label:"最近备份";value:Recovery.cloud-latest;}
            if Recovery.cloud-message!="":Text{text:Recovery.cloud-message;color:Theme.primary;wrap:word-wrap;font-size:12px;min-height:28px;}
            HorizontalLayout {height:32px;spacing:10px;
                ActionButton{text:"测试连接";enabled:!App.busy;clicked=>{Recovery.action("test-cloud");}}
                ActionButton{text:"上传最新备份";enabled:!App.busy&&Recovery.cloud-configured;clicked=>{Recovery.action("cloud-upload");}}
                ActionButton{text:"列出云端备份";enabled:!App.busy&&Recovery.cloud-configured;clicked=>{Recovery.action("cloud-list");}}
                ActionButton{text:"下载选中云端备份";enabled:!App.busy&&Recovery.cloud-configured;clicked=>{Recovery.action("cloud-download");}}
            }
            HorizontalLayout {height:32px;spacing:10px;
                Text{text:"云端备份选择";color:Theme.muted;vertical-alignment:center;}
                ComboBox{model:Recovery.cloud-backup-names;current-index<=>Recovery.cloud-backup-index;horizontal-stretch:1;enabled:!App.busy;}
                Rectangle{horizontal-stretch:1;}
            }
            HorizontalLayout {height:32px;spacing:10px;
                Rectangle{horizontal-stretch:1;}
                ActionButton{text:"刷新状态";enabled:!App.busy;clicked=>{Recovery.action("status");}}
            }
        }}
        Card {VerticalLayout {padding:16px;spacing:10px;
            Text{text:"PostgreSQL 团队库与服务器迁移";font-size:15px;font-weight:700;color:Theme.ink;height:26px;}
            Text{text:Recovery.team-summary;color:Theme.muted;wrap:word-wrap;font-size:12px;min-height:32px;}
            Text{text:Recovery.migration-summary;color:Theme.muted;wrap:word-wrap;font-size:12px;min-height:32px;}
            HorizontalLayout {height:32px;spacing:10px;
                ActionButton{text:"读取团队库备份";enabled:!App.busy;clicked=>{Recovery.action("team-list");}}
                ActionButton{text:"下载选中团队库备份";enabled:!App.busy;clicked=>{Recovery.action("team-download");}}
                ActionButton{text:"创建团队库备份";enabled:!App.busy;clicked=>{Recovery.action("team-create");}}
                ActionButton{text:"刷新迁移状态";enabled:!App.busy;clicked=>{Recovery.action("migration-status");}}
            }
            HorizontalLayout {height:32px;spacing:10px;
                Text{text:"团队库备份选择";color:Theme.muted;vertical-alignment:center;}
                ComboBox{model:Recovery.team-names;current-index<=>Recovery.team-backup-index;horizontal-stretch:1;enabled:!App.busy;}
                Rectangle{horizontal-stretch:1;}
            }
            HorizontalLayout {height:32px;spacing:10px;
                ActionButton{text:"读取共享库归属";enabled:!App.busy;clicked=>{Recovery.action("ownership");}}
                Text{text:Recovery.ownership-summary;color:Theme.muted;horizontal-stretch:1;vertical-alignment:center;overflow:elide;}
            }
        }}
    }
}
