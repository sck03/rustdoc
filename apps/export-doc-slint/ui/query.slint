import { LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { App } from "models.slint";
import { Query, InvoiceFiles } from "document-files-models.slint";
import { Theme, Card, ActionButton } from "theme.slint";
import { DataTable } from "data-table.slint";

component Filter inherits VerticalLayout {
    in property <string> label;
    spacing:5px;
    Text{text:root.label;color:Theme.muted;font-size:12px;height:18px;}
    @children
}
export component QueryPage inherits VerticalLayout {
    padding:0px;spacing:14px;
    Card {preferred-height:Query.advanced?252px:158px;
        VerticalLayout {padding:16px;spacing:12px;
            HorizontalLayout {spacing:12px;
                Filter {label:"船期／航期 · 开始";width:160px;LineEdit{text<=>Query.start;placeholder-text:"YYYY-MM-DD";accessible-label:"船期开始日期";}}
                Filter {label:"结束日期（含当天）";width:160px;LineEdit{text<=>Query.end;placeholder-text:"YYYY-MM-DD";accessible-label:"船期结束日期";}}
                Filter {label:"发票号、合同号、客户或商品";horizontal-stretch:1;LineEdit{input-type:InputType.search;text<=>Query.keyword;placeholder-text:"输入关键词，按 Enter 查询";accepted=>{Query.action("search");}}}
            }
            HorizontalLayout {height:36px;spacing:8px;
                ActionButton{text:"查询";primary:true;enabled:!App.busy;clicked=>{Query.action("search");}}
                ActionButton{text:"刷新";enabled:!App.busy;clicked=>{Query.action("refresh");}}
                ActionButton{text:"重置";enabled:!App.busy;clicked=>{Query.action("reset");}}
                ActionButton{text:Query.advanced?"▾ 收起更多条件":"▸ 更多条件";clicked=>{Query.advanced=!Query.advanced;}}
                Rectangle{horizontal-stretch:1;}
                ActionButton{text:"导出查询结果 Excel";visible:Query.can-export;enabled:!App.busy;clicked=>{Query.action("export");}}
            }
            if Query.advanced:HorizontalLayout {spacing:10px;
                Filter {label:"客户";ComboBox{model:Query.customers;current-index<=>Query.customer-index;}}
                Filter {label:"出口商";ComboBox{model:Query.exporters;current-index<=>Query.exporter-index;}}
                Filter {label:"数据类型";ComboBox{model:["全部类型","实际数据","报关数据"];current-index<=>Query.type-index;}}
                Filter {label:"运输方式";ComboBox{model:["全部方式","BY SEA","BY AIR","BY TRAIN","BY DHL","BY FedEx"];current-index<=>Query.transport-index;}}
                Filter {label:"合同号";LineEdit{text<=>Query.contract;}}
                Filter {label:"商品名称";LineEdit{text<=>Query.style-name;}}
                Filter {label:"款号";LineEdit{text<=>Query.style-no;}}
            }
        }
    }
    Card {vertical-stretch:1;
        VerticalLayout {padding:16px;spacing:10px;
            ScrollView {content-width:max(self.visible-width,1720px);content-height:self.visible-height;
                DataTable {width:parent.width;height:parent.height;}
            }
            HorizontalLayout {height:36px;spacing:8px;
                ActionButton{text:"打开单据";visible:Query.can-open;enabled:App.selected-id>0&&!App.busy;clicked=>{App.open-record(App.selected-id);}}
                Rectangle{horizontal-stretch:1;}
                Text{text:"共 "+App.total-records+" 条 · "+App.list-page+" / "+App.total-pages+" 页";color:Theme.muted;vertical-alignment:center;}
                ComboBox{model:["20 条/页","50 条/页","100 条/页","200 条/页"];current-index<=>Query.page-size-index;width:120px;enabled:!App.busy;selected=>{Query.action("page-size");}}
                ActionButton{text:"上一页";enabled:App.list-page>1&&!App.busy;clicked=>{App.change-page(-1);}}
                ActionButton{text:"下一页";enabled:App.list-page<App.total-pages&&!App.busy;clicked=>{App.change-page(1);}}
            }
        }
    }
}
export component InvoicePackageDialog inherits Rectangle {
    background:#092d2870;TouchArea{}
    Card {x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:min(740px,parent.width - 40px);height:430px;
        VerticalLayout {padding:24px;spacing:14px;
            Text{text:"导入单据包";font-size:22px;color:Theme.ink;font-weight:700;height:34px;}
            Text{text:InvoiceFiles.name;color:Theme.muted;overflow:elide;height:24px;}
            Text{text:InvoiceFiles.summary;color:InvoiceFiles.valid?Theme.ink:Theme.error;wrap:word-wrap;vertical-stretch:1;}
            if InvoiceFiles.conflict:HorizontalLayout {height:36px;spacing:12px;
                Text{text:"已有同号同类型单据";color:Theme.muted;vertical-alignment:center;}
                ComboBox{model:["跳过导入","覆盖原草稿","使用新发票号","追加商品明细"];current-index<=>InvoiceFiles.action-index;horizontal-stretch:1;enabled:!App.busy;}
            }
            if InvoiceFiles.conflict&&InvoiceFiles.action-index==2:LineEdit{text<=>InvoiceFiles.new-number;placeholder-text:"新发票号（留空将自动生成）";accessible-label:"新发票号";}
            HorizontalLayout {height:36px;spacing:8px;alignment:end;
                ActionButton{text:"取消";enabled:!App.busy;clicked=>{InvoiceFiles.action("cancel");}}
                ActionButton{text:"确认导入";primary:true;enabled:InvoiceFiles.valid&&!App.busy;clicked=>{InvoiceFiles.action("import");}}
            }
        }
    }
}
