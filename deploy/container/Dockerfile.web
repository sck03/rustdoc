FROM node:24-trixie-slim AS build
WORKDIR /web
COPY apps/export-doc-web/package.json apps/export-doc-web/package-lock.json ./
RUN npm ci
COPY apps/export-doc-web/ ./
RUN npm run build

FROM nginx:1.30.4-alpine3.24
COPY deploy/container/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/container/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/
COPY THIRD_PARTY_NOTICES.md THIRD_PARTY_DEPENDENCIES.md /usr/share/nginx/html/legal/
RUN chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/nginx.conf /etc/nginx/conf.d
USER nginx
EXPOSE 8080
