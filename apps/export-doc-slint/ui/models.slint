export struct NavRow { key:string, label:string, group:bool, active:bool }
export struct PageTab { key:string, label:string }
export struct DataRow { id:int, cells:[string] }
export struct FormField { key:string, label:string, value:string, kind:string, options:[string], selected:int, level:int }
export struct FormSection { key:string, title:string, expanded:bool, filled:int, fields:[FormField] }
export struct OrganizationRow { code:string, name:string, manager:string, depth:int, children:int, expanded:bool, active:bool }
export struct PersonRow { id:int, name:string, number:string, department:string, job-title:string, email:string, phone:string, location:string, state:string, can-open:bool }
export struct OfficeCard { id:int, title:string, state:string, details:string, description:string, actions:[PageTab], directory:bool }
export struct BackupRow { index:int, name:string, size:string, created:string, modified:string }
export struct WorklistRow { index:int, title:string, description:string, source:string, due:string, overdue:bool }
export struct AttachmentRow { id:int, title:string, invoice:string, customer:string, category:string, reference:string, version:string, archived:bool }
export struct AttachmentVersion { revision:int, file-name:string, size:string, uploaded:string, note:string, current:bool, can-preview:bool }
export struct GridColumn { key:string, label:string, width:float, offset:float, visible:bool }
export struct GridRow { index:int, cells:[string] }
export struct DesignElement { id:string, label:string, text:string, x:float, y:float, w:float, h:float, selected:bool, kind:string, font-size:float }
export struct Metric { label:string, value:string }
