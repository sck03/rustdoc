import { LineEdit, ComboBox } from "std-widgets.slint";
import { App } from "models.slint";
import { DataTable } from "data-table.slint";
import { Theme, ActionButton, Card } from "theme.slint";
import { PartyFileActions } from "party-files.slint";
import { BusinessFilters } from "crm.slint";
import { InvoiceFiles } from "document-files-models.slint";
export component RecordsPage inherits Rectangle {
    background:transparent;
    VerticalLayout {
        padding:0px;spacing:14px;
        if App.resource=="crm-customers"||App.resource=="suppliers":PartyFileActions {height:36px;alignment:start;}
        if App.resource=="crm-customers"||App.resource=="suppliers"||App.resource=="crm-follow-ups":BusinessFilters{}
        if App.metrics.length>0: HorizontalLayout {
            height:94px;spacing:12px;
            for metric in App.metrics: Card {VerticalLayout {padding:16px;spacing:8px;
                Text{text:metric.label;color:Theme.muted;font-size:13px;}
                Text{text:metric.value;color:Theme.primary;font-size:24px;font-weight:700;}
            }}
        }
        if App.tabs.length>0: HorizontalLayout {
            height:36px;spacing:7px;alignment:start;
            for tab in App.tabs: ActionButton {text:tab.label;active:App.resource==tab.key;clicked=>{App.open-tab(tab.key);}}
        }
        Card {
            VerticalLayout {
                padding:16px;spacing:14px;
                HorizontalLayout {height:36px;spacing:8px;
                    LineEdit {input-type:InputType.search;accessible-label:"搜索当前列表";text<=>App.search;placeholder-text:"输入关键词搜索";horizontal-stretch:1;accepted=>{App.refresh();}}
                    if App.resource=="jobs":ComboBox{model:["全部状态","正在处理","正在取消","已完成","处理失败","已取消"];current-index<=>App.job-status-index;width:132px;enabled:!App.busy;selected=>{App.refresh();}}
                    ActionButton {text:"查询";enabled:!App.busy;clicked=>{App.refresh();}}
                    ActionButton {text:"刷新";enabled:!App.busy;clicked=>{App.refresh();}}
                    if App.resource=="invoices":ActionButton{text:"导入 Excel";visible:App.can-import;enabled:!App.busy;clicked=>{App.excel-action("import");}}
                    if App.resource=="invoices"&&InvoiceFiles.can-import:ActionButton{text:"导入单据包";enabled:!App.busy;clicked=>{InvoiceFiles.action("choose");}}
                    if App.resource=="jobs":ActionButton{text:"清理已结束任务";enabled:!App.busy;clicked=>{App.file-action("clear-finished");}}
                    ActionButton {text:App.resource=="invoices"?"＋ 新建发票":"＋ 新建";primary:true;visible:App.can-create;enabled:!App.busy;clicked=>{App.new-record();}}
                }
                DataTable{}
                if App.resource=="jobs" && App.job-detail!="":Text{text:App.job-detail;wrap:word-wrap;color:Theme.muted;max-height:90px;overflow:elide;}
                HorizontalLayout {height:36px;spacing:8px;
                    ActionButton {text:"编辑 / 查看";enabled:App.selected-id>0&&!App.busy;visible:App.can-edit;clicked=>{App.open-record(App.selected-id);}}
                    if App.resource=="invoices"&&InvoiceFiles.can-export:ActionButton{text:"导出单据包";enabled:App.selected-id>0&&!App.busy;clicked=>{InvoiceFiles.action("export");}}
                    for action in App.actions: ActionButton {text:action.label;enabled:!App.busy;clicked=>{App.record-action(action.key);}}
                    if App.resource=="payments":ActionButton {text:"付款 / 报销 PDF";enabled:App.selected-id>0&&!App.busy;clicked=>{App.record-action("payment-report");}}
                    if App.resource=="jobs":HorizontalLayout {spacing:8px;
                        ActionButton{text:"保存结果";enabled:App.selected-id>0&&App.job-can-download&&!App.busy;clicked=>{App.file-action("download");}}
                        ActionButton{text:"重试任务";enabled:App.selected-id>0&&App.job-can-retry&&!App.busy;clicked=>{App.file-action("retry");}}
                        ActionButton{text:"取消任务";enabled:App.selected-id>0&&App.job-can-cancel&&!App.busy;clicked=>{App.file-action("cancel");}}
                        ActionButton{text:"清理此任务";enabled:App.selected-id>0&&App.job-can-delete&&!App.busy;clicked=>{App.file-action("delete");}}
                    }
                    ActionButton {text:"删除";visible:App.can-delete;enabled:App.selected-id>0&&!App.busy;clicked=>{App.delete-record();}}
                    Rectangle {horizontal-stretch:1;}
                    Text{text:"共 "+App.total-records+" 条  ·  "+App.list-page+" / "+App.total-pages+" 页";font-size:12px;color:Theme.muted;vertical-alignment:center;}
                    ActionButton {text:"上一页";enabled:App.list-page>1&&!App.busy;clicked=>{App.change-page(-1);}}
                    ActionButton {text:"下一页";enabled:App.list-page<App.total-pages&&!App.busy;clicked=>{App.change-page(1);}}
                }
            }
        }
    }
}
