import { ScrollView, LineEdit, ComboBox, CheckBox, TextEdit } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, Card, ActionButton, Badge } from "theme.slint";
import { PdfView } from "pdf.slint";

export component AttachmentsPage inherits Rectangle {
    background:transparent;
    if App.attachment-preview-kind!="":VerticalLayout{padding:0px;spacing:12px;
        HorizontalLayout{height:36px;spacing:12px;
            ActionButton{text:"返回资料版本";enabled:!App.busy;clicked=>{App.attachment-action("close-preview","");}}
            Text{text:App.attachment-preview-title;color:Theme.ink;font-size:18px;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
        }
        Card{
            if App.attachment-preview-kind=="pdf":PdfView{report-controls:false;}
            if App.attachment-preview-kind=="image":Image{source:App.attachment-image;image-fit:contain;}
            if App.attachment-preview-kind=="text":TextEdit{text:App.attachment-text;read-only:true;wrap:word-wrap;}
        }
    }
    if App.attachment-preview-kind=="":VerticalLayout{padding:0px;spacing:14px;
        if !App.attachment-detail:VerticalLayout{padding:0px;spacing:14px;
            HorizontalLayout{height:36px;spacing:10px;
                Text{text:"归档原始资料、确认文件和交付文件，完整保留历史版本。";color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
                ActionButton{text:"新增分类";visible:App.attachment-can-manage-categories;enabled:!App.busy;clicked=>{App.attachment-action("category","");}}
                ActionButton{text:"分类改名";visible:App.attachment-can-manage-categories;enabled:!App.busy&&App.attachment-category-index>0;clicked=>{App.attachment-action("category-rename","");}}
                ActionButton{text:"删除分类";visible:App.attachment-can-manage-categories;enabled:!App.busy&&App.attachment-category-index>0;clicked=>{App.attachment-action("category-delete","");}}
                ActionButton{text:"＋ 上传资料";primary:true;visible:App.attachment-can-upload;enabled:!App.busy&&App.attachment-invoice-index>0;clicked=>{App.attachment-action("upload","");}}
            }
            Card{VerticalLayout{padding:16px;spacing:12px;
                HorizontalLayout{height:36px;spacing:8px;
                    ComboBox{model:App.attachment-invoice-options;current-index<=>App.attachment-invoice-index;accessible-label:"所属发票";horizontal-stretch:1;enabled:!App.busy;selected(value)=>{App.attachment-action("filter","");}}
                    ComboBox{model:App.attachment-category-options;current-index<=>App.attachment-category-index;accessible-label:"资料分类";width:180px;enabled:!App.busy;selected(value)=>{App.attachment-action("filter","");}}
                }
                HorizontalLayout{height:36px;spacing:8px;
                    LineEdit{text<=>App.search;input-type:InputType.search;accessible-label:"搜索业务资料";placeholder-text:"资料名称、发票、PO 或款号";horizontal-stretch:1;accepted=>{App.attachment-action("filter","");}}
                    CheckBox{text:"包括停用资料";checked<=>App.attachment-include-archived;enabled:!App.busy;toggled=>{App.attachment-action("filter","");}}
                    ActionButton{text:"查询";enabled:!App.busy;clicked=>{App.attachment-action("filter","");}}
                    ActionButton{text:"刷新";enabled:!App.busy;clicked=>{App.refresh();}}
                }
                Text{text:App.attachment-capacity;color:Theme.muted;font-size:12px;height:24px;}
                ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:10px;alignment:start;
                    for item in App.attachment-rows:Card{height:110px;
                        HorizontalLayout{padding:15px;spacing:14px;
                            VerticalLayout{spacing:8px;horizontal-stretch:1;
                                Text{text:item.title;color:Theme.ink;font-size:17px;font-weight:700;overflow:elide;}
                                Text{text:item.invoice+" · "+item.customer+" · "+item.category;color:Theme.muted;font-size:12px;overflow:elide;}
                                Text{text:item.reference;color:Theme.muted;font-size:12px;overflow:elide;}
                            }
                            VerticalLayout{spacing:8px;width:245px;alignment:center;
                                Text{text:item.version;color:Theme.primary;font-size:12px;overflow:elide;horizontal-alignment:right;}
                                HorizontalLayout{spacing:8px;if item.archived:Badge{text:"停用";}ActionButton{text:"查看版本与文件";enabled:!App.busy;clicked=>{App.attachment-action("open",item.id+"");}}}
                            }
                        }
                    }
                    if App.attachment-rows.length==0:Text{text:App.busy?"正在读取资料…":"没有符合条件的业务资料";color:Theme.muted;height:140px;horizontal-alignment:center;}
                }}
                HorizontalLayout{height:36px;spacing:8px;
                    Text{text:"共 "+App.total-records+" 份资料";color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
                    ActionButton{text:"上一页";enabled:!App.busy&&App.list-page>1;clicked=>{App.change-page(-1);}}
                    Text{text:App.list-page+" / "+max(1,App.total-pages);color:Theme.muted;vertical-alignment:center;}
                    ActionButton{text:"下一页";enabled:!App.busy&&App.list-page<App.total-pages;clicked=>{App.change-page(1);}}
                }
            }}
        }
        if App.attachment-detail:VerticalLayout{padding:0px;spacing:12px;
            HorizontalLayout{height:38px;spacing:10px;
                ActionButton{text:"返回资料列表";enabled:!App.busy;clicked=>{App.attachment-action("back","");}}
                Text{text:App.attachment-title;color:Theme.ink;font-size:21px;font-weight:700;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
                ActionButton{text:"打开所属发票";enabled:!App.busy;clicked=>{App.attachment-action("invoice","");}}
            }
            Text{text:App.attachment-description;color:Theme.muted;height:24px;overflow:elide;}
            Card{VerticalLayout{padding:16px;spacing:12px;
                if App.attachment-can-edit||App.attachment-can-delete:VerticalLayout{padding:0px;spacing:10px;
                    LineEdit{text<=>App.attachment-note;placeholder-text:"填写确认依据或停用、恢复、删除原因";accessible-label:"资料操作说明";enabled:!App.busy;}
                    HorizontalLayout{height:36px;spacing:8px;alignment:start;
                        ActionButton{text:"修正资料信息";visible:App.attachment-can-edit;enabled:!App.busy;clicked=>{App.attachment-action("edit","");}}
                        ActionButton{text:"上传新版本";primary:true;visible:App.attachment-can-edit&&!App.attachment-archived;enabled:!App.busy;clicked=>{App.attachment-action("replace","");}}
                        ActionButton{text:App.attachment-archived?"恢复资料":"停用资料";visible:App.attachment-can-edit;enabled:!App.busy;clicked=>{App.attachment-action("archive","");}}
                        ActionButton{text:"永久删除资料";visible:App.attachment-can-delete;enabled:!App.busy;clicked=>{App.attachment-action("delete","");}}
                    }
                }
                ScrollView{content-width:self.visible-width;VerticalLayout{padding:0px;spacing:12px;alignment:start;
                    for version in App.attachment-versions:Card{min-height:155px;
                        VerticalLayout{padding:15px;spacing:10px;
                            HorizontalLayout{height:27px;spacing:8px;Text{text:"v"+version.revision+" · "+version.file-name;color:Theme.ink;font-size:16px;font-weight:700;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}if version.current:Badge{text:"当前有效";}}
                            Text{text:version.size+" · "+version.uploaded;color:Theme.muted;font-size:12px;overflow:elide;}
                            if version.note!="":Text{text:version.note;color:Theme.muted;font-size:12px;wrap:word-wrap;min-height:20px;}
                            HorizontalLayout{height:36px;spacing:8px;alignment:start;
                                ActionButton{text:"保存原文件";enabled:!App.busy;clicked=>{App.attachment-action("download",version.revision+"");}}
                                ActionButton{text:"预览";visible:version.can-preview;enabled:!App.busy;clicked=>{App.attachment-action("preview",version.revision+"");}}
                                ActionButton{text:"设为有效版本";visible:App.attachment-can-edit&&!App.attachment-archived&&!version.current;enabled:!App.busy;clicked=>{App.attachment-action("confirm",version.revision+"");}}
                            }
                        }
                    }
                    ActionButton{text:(App.attachment-events-open?"▾ ":"▸ ")+"资料操作记录（"+App.attachment-events.length+"）";left-aligned:true;clicked=>{App.attachment-events-open=!App.attachment-events-open;}}
                    if App.attachment-events-open:VerticalLayout{spacing:10px;for event in App.attachment-events:Text{text:event.label;color:Theme.muted;wrap:word-wrap;min-height:45px;}}
                }}
            }}
        }
    }
}
