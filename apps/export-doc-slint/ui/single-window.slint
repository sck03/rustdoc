import { LineEdit,TextEdit,ComboBox,ScrollView } from "std-widgets.slint";
import { App } from "models.slint";
import { SingleWindow as Sw } from "single-window-models.slint";
import { SingleWindowEditor } from "single-window-editor.slint";
import { Theme,ActionButton,Card } from "theme.slint";
import { FormView } from "forms.slint";
import { RecordTable } from "data-table.slint";

export component SingleWindowPage inherits VerticalLayout {
    spacing:10px;
    HorizontalLayout {height:38px;spacing:8px;alignment:start;
        for title[index] in ["操作中心","原产地证","代理委托","持卡机档案","申报词典"]:ActionButton {
            text:title;primary:Sw.tab==index;enabled:!App.busy&&(index!=4||Sw.can-dictionary)&&(index!=3||Sw.can-profiles);clicked=>{Sw.action("tab",index);}
        }
        Rectangle {horizontal-stretch:1;}
        ActionButton {text:"刷新";enabled:!App.busy;clicked=>{Sw.action("refresh",0);}}
    }
    if Sw.tab==1||Sw.tab==2:SingleWindowEditor{}
    if Sw.tab==0:VerticalLayout {spacing:10px;
        HorizontalLayout {height:38px;spacing:8px;
            ComboBox {model:["全部业务","原产地证","代理委托"];current-index<=>Sw.business-filter;selected=>{Sw.action("search",0);}}
            ComboBox {model:["全部状态","已导出提交包","已导入提交包","已送入客户端","已受理","待审核","已通过","已退回","失败"];current-index<=>Sw.status-filter;selected=>{Sw.action("search",0);}}
            LineEdit {text<=>Sw.keyword;placeholder-text:"批次、发票号、合同号、官方编号";horizontal-stretch:1;accepted=>{Sw.action("search",0);}}
            ActionButton {text:"查询";enabled:!App.busy;clicked=>{Sw.action("search",0);}}
            ActionButton {text:"导入提交包";enabled:Sw.can-profiles&&!App.busy;clicked=>{Sw.action("import-submit",0);}}
            ActionButton {text:"导入回执包";enabled:Sw.can-export&&!App.busy;clicked=>{Sw.action("import-receipt",0);}}
        }
        Card {vertical-stretch:1;RecordTable {columns:["批次","业务","发票号","版本","状态","官方编号","更新时间"];rows:Sw.batches;selected-id:Sw.selected-batch;busy:App.busy;selected(id)=>{Sw.action("batch",id);}}}
        HorizontalLayout {height:32px;spacing:8px;alignment:end;
            Text {text:Sw.page+" / "+Sw.total-pages;vertical-alignment:center;color:Theme.muted;}
            ActionButton {text:"上一页";enabled:Sw.page>1&&!App.busy;clicked=>{Sw.action("page",-1);}}
            ActionButton {text:"下一页";enabled:Sw.page<Sw.total-pages&&!App.busy;clicked=>{Sw.action("page",1);}}
        }
        if Sw.selected-batch>0:VerticalLayout {spacing:8px;vertical-stretch:1;
            Text {text:Sw.detail;color:Theme.muted;wrap:word-wrap;min-height:28px;}
            HorizontalLayout {height:36px;spacing:8px;alignment:start;
                ActionButton {text:"包记录";primary:Sw.detail-tab==0;clicked=>{Sw.detail-tab=0;}}
                ActionButton {text:"回执记录";primary:Sw.detail-tab==1;clicked=>{Sw.detail-tab=1;}}
                ActionButton {text:"送入官方客户端";enabled:Sw.can-profiles&&!App.busy;clicked=>{Sw.action("dispatch",0);}}
                ActionButton {text:"收集回执";enabled:Sw.can-profiles&&!App.busy;clicked=>{Sw.action("collect",0);}}
                ActionButton {text:"选择回执文件";enabled:Sw.can-profiles&&!App.busy;clicked=>{Sw.action("add-receipt",0);}}
                ActionButton {text:"导出回执包";enabled:Sw.can-profiles&&!App.busy&&Sw.receipt-files.length>0;clicked=>{Sw.action("export-receipt",0);}}
            }
            if Sw.detail-tab==0:Card {RecordTable {columns:["类型","方向","报文","附件","警告","时间"];rows:Sw.packages;busy:App.busy;}}
            if Sw.detail-tab==1:Card {RecordTable {columns:["回执类型","官方编号","代码","说明","状态","时间"];rows:Sw.receipts;busy:App.busy;}}
            if Sw.receipt-files.length>0:HorizontalLayout {height:32px;spacing:8px;
                Text {text:"已选择 "+Sw.receipt-files.length+" 个回执文件";color:Theme.primary;vertical-alignment:center;}
                ActionButton {text:"清空所选";clicked=>{Sw.action("clear-receipts",0);}}
            }
        }
    }
    if Sw.tab==3:HorizontalLayout {spacing:12px;
        VerticalLayout {horizontal-stretch:1;spacing:10px;
            Card {RecordTable {columns:["档案名称","公司抬头","操作卡","当前"];rows:Sw.profiles;selected-id:Sw.selected-profile;busy:App.busy;selected(id)=>{Sw.action("profile",id);}}}
            HorizontalLayout {height:36px;spacing:8px;alignment:start;
                ActionButton {text:"新增档案";enabled:Sw.can-profiles&&!App.busy;clicked=>{Sw.action("new-profile",0);}}
                ActionButton {text:"设为当前档案";enabled:Sw.selected-profile>0&&!App.busy;clicked=>{Sw.action("activate-profile",Sw.selected-profile);}}
                ActionButton {text:"复制授权码";enabled:Sw.selected-profile>0&&!App.busy;clicked=>{Sw.action("copy-assignment",Sw.selected-profile);}}
            }
            Text {text:"不同公司抬头和操作卡分别建档；切换当前档案后再导入和派发。";color:Theme.muted;wrap:word-wrap;min-height:40px;}
        }
        Card {horizontal-stretch:1;VerticalLayout {padding:12px;spacing:8px;
            FormView {fields:Sw.profile-fields;enabled:!App.busy;edited(key,value)=>{Sw.edited("profile."+key,value);}selected(key,index)=>{Sw.chosen("profile."+key,index);}}
            ActionButton {text:"保存档案";primary:true;enabled:Sw.profile-fields.length>0&&!App.busy;clicked=>{Sw.action("save-profile",0);}}
        }}
    }
    if Sw.tab==4:VerticalLayout {spacing:10px;
        HorizontalLayout {height:38px;spacing:8px;alignment:start;
            ComboBox {model:["原产地证国家","代理委托国家","币种","贸易方式","运输方式","港口"];current-index<=>Sw.dictionary;selected=>{Sw.action("dictionary",self.current-index);}}
            ActionButton {text:"新增条目";enabled:Sw.can-dictionary&&!App.busy;clicked=>{Sw.action("new-dictionary-row",0);}}
            ActionButton {text:"删除条目";enabled:Sw.selected-dictionary-row>0&&!App.busy;clicked=>{Sw.action("remove-dictionary-row",Sw.selected-dictionary-row);}}
            ActionButton {text:"保存词典";primary:true;enabled:Sw.can-dictionary&&!App.busy;clicked=>{Sw.action("save-dictionary",0);}}
            ActionButton {text:"恢复内置词典";enabled:Sw.can-dictionary&&!App.busy;clicked=>{Sw.action("reset-dictionary",0);}}
        }
        HorizontalLayout {spacing:12px;
            Card {horizontal-stretch:1;RecordTable {columns:["代码／标准值","名称","英文名称","别名"];rows:Sw.dictionary-rows;selected-id:Sw.selected-dictionary-row;busy:App.busy;selected(id)=>{Sw.action("dictionary-row",id);}}}
            Card {horizontal-stretch:1;VerticalLayout {padding:12px;spacing:8px;
                FormView {fields:Sw.dictionary-fields;enabled:!App.busy;edited(key,value)=>{Sw.edited("dictionary."+key,value);}}
                ActionButton {text:"应用条目修改";enabled:Sw.dictionary-fields.length>0&&!App.busy;clicked=>{Sw.action("apply-dictionary-row",0);}}
            }}
        }
    }
}

export component ProducerDialog inherits Rectangle {
    background:#092d2870;TouchArea{}
    Card {x:(parent.width - self.width)/2;y:40px;width:min(1080px,parent.width - 60px);height:parent.height - 80px;
        VerticalLayout {padding:20px;spacing:12px;
            Text {text:"生产企业资料";font-size:20px;color:Theme.ink;font-weight:700;height:32px;}
            HorizontalLayout {height:38px;spacing:8px;
                LineEdit {text<=>Sw.producer-keyword;placeholder-text:"代码、名称、款号、发票号";horizontal-stretch:1;accepted=>{Sw.action("find-producers",0);}}
                ActionButton {text:"查询";enabled:!App.busy;clicked=>{Sw.action("find-producers",0);}}
            }
            RecordTable {columns:["企业代码","企业名称","联系人","电话","最近款号"];rows:Sw.producers;selected-id:Sw.selected-producer;busy:App.busy;selected(id)=>{Sw.selected-producer=id;}}
            HorizontalLayout {height:36px;spacing:8px;alignment:end;
                ActionButton {text:"取消";clicked=>{Sw.producers-open=false;}}
                ActionButton {text:"填入所选商品";primary:true;enabled:Sw.selected-producer>0&&!App.busy;clicked=>{Sw.action("apply-producer",Sw.selected-producer);}}
            }
        }
    }
}
