import { ScrollView } from "std-widgets.slint";
import { App, DataRow } from "models.slint";
import { Theme } from "theme.slint";
export component RecordTable inherits VerticalLayout {
    in property <[string]> columns;
    in property <[DataRow]> rows;
    in property <int> selected-id;
    in property <bool> busy;
    callback selected(int);
    callback opened(int);
    padding:0px;spacing:0px;
    Rectangle {height:42px;background:Theme.soft;border-radius:6px;
        HorizontalLayout {padding:10px;spacing:12px;
            for column in root.columns:Text{text:column;font-size:12px;color:Theme.muted;horizontal-stretch:1;overflow:elide;vertical-alignment:center;}
        }
    }
    ScrollView {content-width:self.visible-width;
        VerticalLayout {padding:0px;spacing:0px;
            for row in root.rows:Rectangle {
                height:46px;background:root.selected-id==row.id?#e7f5ef:touch.has-hover?#f5f9f7:white;
                Rectangle {y:parent.height - 1px;height:1px;background:#e7efeb;}
                HorizontalLayout {padding:10px;spacing:12px;
                    for cell in row.cells:Text{text:cell;color:Theme.ink;font-size:13px;horizontal-stretch:1;overflow:elide;vertical-alignment:center;}
                }
                touch:=TouchArea {clicked=>{root.selected(row.id);} double-clicked=>{root.opened(row.id);}}
            }
            if root.rows.length==0:Text{text:root.busy?"正在读取…":"暂无记录";horizontal-alignment:center;color:Theme.muted;min-height:130px;}
        }
    }
}
export component DataTable inherits RecordTable {
    columns:App.columns;rows:App.records;selected-id:App.selected-id;busy:App.busy;
    selected(id)=>{App.select-record(id);} opened(id)=>{App.open-record(id);}
}
