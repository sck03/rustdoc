POSTGRES_DB=exportdoc
POSTGRES_USER=exportdoc
POSTGRES_PASSWORD=replace-with-a-long-random-password
EXPORTDOCMANAGER_BOOTSTRAP_TOKEN=replace-with-a-different-random-token-at-least-24-characters
# 可选：32 字节主密钥的 Base64 或 64 位十六进制；设置后必须长期安全备份，不能随意更换。
# EXPORTDOCMANAGER_MASTER_KEY=
EXPORTDOCMANAGER_WEB_PORT=8080
EXPORTDOCMANAGER_HTTPS_PORT=8443
# HTTPS overlay requires explicit certificate paths on the deployment host.
EXPORTDOCMANAGER_TLS_CERTIFICATE=./secrets/tls/server.crt
EXPORTDOCMANAGER_TLS_PRIVATE_KEY=./secrets/tls/server.key
EXPORTDOCMANAGER_RUNTIME_ROOT=./runtime
EXPORTDOCMANAGER_ALLOWED_ORIGINS=
# 不提供仓库级固定默认值。initialize-container-runtime.ps1 会检查宿主机接口、
# 路由表和现有 Docker 网络，自动填写紧凑且不重叠的专用 /28 与 Nginx 地址。
# 企业 VPN/特殊路由无法自动确认时，请由管理员显式指定匹配的 /24 至 /28 和代理 IP。
EXPORTDOCMANAGER_CONTAINER_SUBNET=
EXPORTDOCMANAGER_REVERSE_PROXY_IP=
# 若公网 HTTPS/CDN 代理位于内置 Nginx 前方，填写其直接连接来源 IP；多个地址用分号分隔。
EXPORTDOCMANAGER_ADDITIONAL_TRUSTED_PROXIES=
EXPORTDOCMANAGER_IMAGE_NAMESPACE=ghcr.io/your-github-account
EXPORTDOCMANAGER_IMAGE_TAG=latest
# Linux one-command installer state. Public HTTPS keeps Nginx as the only business proxy;
# Certbot only manages certificates and ACME challenges.
EXPORTDOCMANAGER_DEPLOYMENT_MODE=http
EXPORTDOCMANAGER_PUBLIC_DOMAIN=
EXPORTDOCMANAGER_ACME_EMAIL=
TZ=Asia/Shanghai
