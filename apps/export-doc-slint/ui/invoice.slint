import { LineEdit, TextEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, ActionButton, Badge, Card } from "theme.slint";
import { FormView, FormSections } from "forms.slint";
import { InvoiceGridView } from "invoice-grid.slint";
import { PdfView } from "pdf.slint";
import { DocumentPackagePanel } from "document-package.slint";
export component InvoicePage inherits Rectangle {
    background:transparent;
    VerticalLayout {padding:0px;spacing:12px;
        HorizontalLayout {height:36px;spacing:8px;
            ActionButton {text:"← 返回列表";clicked=>{App.invoice-action("back");}}
            Rectangle {horizontal-stretch:1;}
            Text{text:App.invoice-title;color:Theme.ink;font-size:13px;vertical-alignment:center;}
            Badge{text:App.dirty?"尚未保存":App.invoice-saved?"已保存":"新建发票";}
        }
        if !App.workbench: Card {
            height:App.review-open?110px:48px;
            VerticalLayout {padding:12px;spacing:8px;
                HorizontalLayout {height:24px;
                    Text{text:App.review-open?"▾ 核对检查":"▸ 核对检查";color:Theme.ink;font-size:13px;vertical-alignment:center;
                        TouchArea {clicked=>{App.review-open=!App.review-open;if(App.review-open){App.invoice-action("review");}}}
                    }
                }
                if App.review-open:Text{text:App.review-text;color:Theme.muted;wrap:word-wrap;font-size:12px;}
            }
        }
        Card {
            height:App.workbench?62px:121px;
            VerticalLayout {padding:12px;spacing:8px;
                HorizontalLayout {height:36px;spacing:10px;
                    VerticalLayout {padding:0px;spacing:4px;
                        Text{text:App.invoice-title;color:Theme.ink;font-size:14px;font-weight:700;}
                        Text{text:App.invoice-summary;color:Theme.muted;font-size:12px;}
                    }
                    Rectangle{horizontal-stretch:1;}
                    ActionButton{text:"保存发票";primary:true;enabled:!App.busy&&App.invoice-editable;clicked=>{App.invoice-action("save");}}
                    ActionButton{text:"业务资料";enabled:App.invoice-saved&&!App.dirty&&!App.busy;clicked=>{App.invoice-action("attachments");}}
                    if App.invoice-tab==4:ActionButton{text:"导出订舱托单";enabled:App.invoice-saved&&!App.dirty&&!App.busy;clicked=>{App.excel-action("booking");}}
                }
                if !App.workbench: HorizontalLayout {height:34px;spacing:6px;alignment:start;
                    for tab[i] in ["基本信息","商品明细","运输与报关","利润与信用证","预览与导出"]:ActionButton{
                        text:tab;active:App.invoice-tab==i;clicked=>{App.invoice-tab-changed(i);}
                    }
                }
                if !App.workbench:Text{text:App.invoice-tab==1?"录入商品与价格，金额自动汇总；较多明细可打开明细工作台。":"按现有单据填写信息，保存后可核对、预览与导出。";color:Theme.muted;font-size:12px;}
            }
        }
        if App.invoice-tab==3:HorizontalLayout{height:36px;spacing:8px;
            ActionButton{text:"导入信用证";enabled:!App.busy&&App.invoice-editable;clicked=>{App.invoice-action("credit-import");}}
            ActionButton{text:"信用证合规审查";enabled:!App.busy;clicked=>{App.invoice-action("credit-review");}}
            Rectangle{horizontal-stretch:1;}
            Text{text:"将当前草稿交由系统设置中的 AI 服务审查";font-size:12px;color:Theme.muted;vertical-alignment:center;}
        }
        if App.invoice-tab==3&&App.credit-report!="":Card{height:220px;
            VerticalLayout{padding:12px;spacing:6px;
                HorizontalLayout{height:30px;Text{text:App.credit-summary;color:Theme.muted;vertical-alignment:center;}Rectangle{horizontal-stretch:1;}ActionButton{text:"复制报告";clicked=>{App.invoice-action("credit-copy");}}}
                TextEdit{text:App.credit-report;read-only:true;wrap:word-wrap;}
            }
        }
        Card {
            if App.invoice-tab!=1&&App.invoice-tab!=4:FormSections{
                sections:App.invoice-sections;editable:App.invoice-editable&&!App.busy;
                toggled(key)=>{App.toggle-form-section(key);}
                edited(key,value)=>{App.invoice-field-edited(key,value);}
                selected(key,index)=>{App.invoice-field-selected(key,index);}
            }
            if App.invoice-tab==4:VerticalLayout{spacing:10px;PdfView{}DocumentPackagePanel{}}
            if App.invoice-tab==1:VerticalLayout{padding:16px;spacing:10px;
                HorizontalLayout{height:32px;spacing:8px;
                    Text{text:"商品明细";color:Theme.ink;font-size:18px;font-weight:700;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}
                    ActionButton{text:App.workbench?"退出明细工作台":"↗ 明细工作台";clicked=>{App.workbench=!App.workbench;}}
                    ActionButton{text:"＋";enabled:App.invoice-editable;clicked=>{App.grid-row-action("insert",App.grid-count - 1);}}
                }
                ActionButton{text:App.marks-open?"▾ 唛头与特殊条款":"▸ 唛头与特殊条款";clicked=>{App.marks-open=!App.marks-open;}}
                if App.marks-open:FormView{
                    height:180px;fields:App.marks-fields;editable:App.invoice-editable&&!App.busy;
                    edited(key,value)=>{App.invoice-field-edited(key,value);}
                    selected(key,index)=>{App.invoice-field-selected(key,index);}
                }
                HorizontalLayout{height:36px;spacing:6px;
                    LineEdit{input-type:InputType.search;accessible-label:"商品库搜索";text<=>App.product-search;placeholder-text:"商品库搜索";preferred-width:180px;accepted=>{App.product-action("search");}}
                    ActionButton{text:"查询";clicked=>{App.product-action("search");}}
                    ComboBox{model:App.products;current-index<=>App.product-index;horizontal-stretch:1;}
                    ActionButton{text:"加入商品";enabled:App.invoice-editable&&App.products.length>0;clicked=>{App.product-action("insert");}}
                    ActionButton{text:"保存当前商品";visible:App.can-save-product;enabled:!App.busy;clicked=>{App.product-action("save");}}
                    ActionButton{text:"显示列";clicked=>{App.columns-open=true;}}
                    ActionButton{text:"复制";clicked=>{App.grid-command("copy",false);}}
                    ActionButton{text:"粘贴";enabled:App.invoice-editable;clicked=>{App.grid-command("paste",false);}}
                    ActionButton{text:"清空";enabled:App.invoice-editable;clicked=>{App.grid-command("clear",false);}}
                    ActionButton{text:"撤销";enabled:App.can-undo;clicked=>{App.grid-command("undo",false);}}
                    ActionButton{text:"重做";enabled:App.can-redo;clicked=>{App.grid-command("redo",false);}}
                }
                Rectangle {height:46px;background:#f5faf8;border-radius:6px;border-color:Theme.line;border-width:1px;
                    Text{x:10px;width:parent.width - 20px;text:"键盘操作   Enter / Tab 下一行    Shift 反向    ↑↓ 换行    Shift + 方向键 扩选    Ctrl + D 向下填充    Ctrl + Z / Y 撤销 / 重做    Insert 新增行";font-size:12px;color:Theme.muted;wrap:word-wrap;vertical-alignment:center;}
                }
                InvoiceGridView {vertical-stretch:1;}
            }
        }
    }
}
