<Project>
  <PropertyGroup>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1</InformationalVersion>
    <_ExportDocManagerHostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</_ExportDocManagerHostArchitecture>
    <_ExportDocManagerHostOs Condition="$([System.OperatingSystem]::IsWindows())">win</_ExportDocManagerHostOs>
    <_ExportDocManagerHostOs Condition="$([System.OperatingSystem]::IsLinux())">linux</_ExportDocManagerHostOs>
    <_ExportDocManagerHostOs Condition="$([System.OperatingSystem]::IsMacOS())">osx</_ExportDocManagerHostOs>
    <!-- Keep domain/application/infrastructure libraries portable. The API host and the
         ONNX-bearing PDF/OCR module are the only host-RID exceptions; publish scripts may
         still override the RID explicitly for any executable. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(_ExportDocManagerHostOs)' != '' and ('$(MSBuildProjectName)' == 'ExportDocManager.Api' or '$(MSBuildProjectName)' == 'ExportDocManager.Infrastructure.PdfOcr')">$(_ExportDocManagerHostOs)-$(_ExportDocManagerHostArchitecture)</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!-- Capability assemblies are intentionally removable from each edition, so publish output must remain multi-file. -->
    <PublishSingleFile>false</PublishSingleFile>
    <ExportDocRuntimeRestore Condition="'$(ExportDocRuntimeRestore)' == ''">false</ExportDocRuntimeRestore>
    <RestorePackagesWithLockFile Condition="'$(ExportDocRuntimeRestore)' == 'true'">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(ExportDocRuntimeRestore)' == 'true'">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'obj', 'runtime.$(RuntimeIdentifier).packages.lock.json'))</NuGetLockFilePath>
    <RestorePackagesWithLockFile Condition="'$(ExportDocRuntimeRestore)' != 'true' and '$(RuntimeIdentifier)' == ''">true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <_ExportDocOnnxRuntimeFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">onnxruntime.dll</_ExportDocOnnxRuntimeFile>
    <_ExportDocOnnxRuntimeFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">libonnxruntime.so</_ExportDocOnnxRuntimeFile>
    <_ExportDocOnnxRuntimeFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">libonnxruntime.dylib</_ExportDocOnnxRuntimeFile>
  </PropertyGroup>
</Project>
