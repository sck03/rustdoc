{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "外贸业务综合管理系统（全功能版）",
  "version": "0.1.1",
  "identifier": "com.exportdocmanager.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../export-doc-web run dev",
    "beforeBuildCommand": "npm run prepare:bundle",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../export-doc-web/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/app.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../../artifacts/tauri-bundle/resources/": ""
    }
  }
}
