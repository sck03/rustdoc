    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ExportDocManager.Testing" />
    <Compile Include="../Shared/RasterImageFixtures.cs" Link="RasterImageFixtures.cs" />
