import { ScrollView, TextEdit } from "std-widgets.slint";
import { App, DataRow } from "models.slint";
import { Theme, ActionButton, Card } from "theme.slint";
import { RecordTable } from "data-table.slint";
export struct OcrLine {x:float,y:float,width:float,height:float,index:int}
export global Ocr {
    in-out property <bool> ready:false;
    in-out property <bool> has-image:false;
    in-out property <image> image;
    in-out property <float> image-width:1;
    in-out property <float> image-height:1;
    in-out property <float> zoom:1;
    in-out property <string> source;
    in-out property <string> status;
    in-out property <string> text;
    in-out property <[DataRow]> rows;
    in-out property <[OcrLine]> lines;
    in-out property <int> selected:0;
    callback action(string,int);
}
export component OcrPage inherits VerticalLayout {
    spacing:12px;
    HorizontalLayout{height:38px;spacing:8px;
        ActionButton{text:"选择图片";enabled:!App.busy;clicked=>{Ocr.action("choose",0);}}
        ActionButton{text:"粘贴图片";enabled:!App.busy;clicked=>{Ocr.action("paste",0);}}
        ActionButton{text:"开始识别";primary:true;enabled:Ocr.ready&&Ocr.has-image&&!App.busy;clicked=>{Ocr.action("recognize",0);}}
        if App.busy:ActionButton{text:"取消识别";clicked=>{App.cancel-operation();}}
        Rectangle{horizontal-stretch:1;}
        ActionButton{text:"−";enabled:Ocr.has-image;clicked=>{Ocr.zoom=max(0.1,Ocr.zoom/1.25);}}
        Text{text:round(Ocr.zoom*100)+"%";vertical-alignment:center;color:Theme.muted;min-width:44px;horizontal-alignment:center;}
        ActionButton{text:"+";enabled:Ocr.has-image;clicked=>{Ocr.zoom=min(10,Ocr.zoom*1.25);}}
        ActionButton{text:"适合窗口";enabled:Ocr.has-image;clicked=>{Ocr.zoom=1;}}
        ActionButton{text:"重置";enabled:!App.busy;clicked=>{Ocr.action("reset",0);}}
    }
    Text{text:Ocr.status;color:Ocr.ready?Theme.muted:Theme.error;wrap:word-wrap;min-height:26px;}
    HorizontalLayout{spacing:14px;
        Card{horizontal-stretch:3;VerticalLayout{padding:12px;spacing:10px;
            Text{text:Ocr.has-image?Ocr.source:"图片预览";color:Theme.muted;height:26px;overflow:elide;}
            preview:=ScrollView{content-width:max(self.visible-width,Ocr.image-width*scale*Ocr.zoom*1px);content-height:max(self.visible-height,Ocr.image-height*scale*Ocr.zoom*1px);
                in property <float> scale:min(self.visible-width/(Ocr.image-width*1px),self.visible-height/(Ocr.image-height*1px));
                Image{source:Ocr.image;width:Ocr.image-width*preview.scale*Ocr.zoom*1px;height:Ocr.image-height*preview.scale*Ocr.zoom*1px;image-fit:fill;}
                for line in Ocr.lines:Rectangle{
                    x:line.x*preview.scale*Ocr.zoom*1px;y:line.y*preview.scale*Ocr.zoom*1px;width:line.width*preview.scale*Ocr.zoom*1px;height:line.height*preview.scale*Ocr.zoom*1px;
                    background:Ocr.selected==line.index?#22ffb300:transparent;border-width:Ocr.selected==line.index?2px:0px;border-color:#e69a00;
                    TouchArea{clicked=>{Ocr.action("line",line.index);}}
                }
                if !Ocr.has-image:Text{text:"选择图片或从剪贴板粘贴\n支持 PNG、JPEG、BMP、TIFF、WebP";color:Theme.muted;horizontal-alignment:center;vertical-alignment:center;width:parent.content-width;height:parent.content-height;}
            }
        }}
        Card{horizontal-stretch:2;VerticalLayout{padding:12px;spacing:10px;
            HorizontalLayout{height:36px;spacing:8px;Text{text:"识别结果";font-weight:700;color:Theme.ink;vertical-alignment:center;horizontal-stretch:1;}
                ActionButton{text:"复制全文";enabled:Ocr.text!="";clicked=>{Ocr.action("copy",0);}}}
            TextEdit{text:Ocr.text;read-only:true;wrap:word-wrap;vertical-stretch:2;}
            RecordTable{columns:["行","文字"];rows:Ocr.rows;selected-id:Ocr.selected;busy:App.busy;vertical-stretch:1;selected(id)=>{Ocr.action("line",id);}}
            ActionButton{text:"复制选中行";enabled:Ocr.selected>0;clicked=>{Ocr.action("copy-line",0);}}
        }}
    }
}
