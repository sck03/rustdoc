export global Recovery {
    in-out property <bool> loaded:false;
    in-out property <bool> supported:false;
    in-out property <bool> pending-restore:false;
    in-out property <bool> can-create:false;
    in-out property <bool> can-restore:false;
    in-out property <string> recovery-root;
    in-out property <string> message;
    in-out property <string> storage-policy;
    in-out property <string> password;
    in-out property <string> password-confirm;
    in-out property <string> package-path;
    in-out property <string> restore-password;
    in-out property <string> restore-confirmation;
    in-out property <string> cloud-summary;
    in-out property <string> cloud-url;
    in-out property <string> cloud-user;
    in-out property <string> cloud-latest;
    in-out property <string> cloud-message;
    in-out property <bool> cloud-configured:false;
    in-out property <int> cloud-backup-index:0;
    in-out property <[string]> cloud-backup-names;
    in-out property <string> team-summary;
    in-out property <[string]> team-names;
    in-out property <int> team-backup-index:0;
    in-out property <string> migration-summary;
    in-out property <string> ownership-summary;
    in-out property <[string]> ownership-users;
    in-out property <int> ownership-from-index:0;
    in-out property <int> ownership-to-index:0;
    in-out property <bool> ownership-include-invoices:true;
    in-out property <bool> ownership-include-payments:true;
    in-out property <bool> ownership-include-other:true;
    in-out property <bool> ownership-only-unassigned:false;
    in-out property <string> ownership-confirmation;
    in-out property <string> migration-password;
    in-out property <string> migration-admin-password;
    in-out property <string> migration-confirmation;
    callback action(string);
}
