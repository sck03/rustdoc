import { AboutSlint, LineEdit, ScrollView, CheckBox } from "std-widgets.slint";
import "../../../Resources/Fonts/OpenSource/NotoSansCJKsc-Regular.otf";
import { App, NavRow, PageTab, DataRow, FormField, FormSection, OrganizationRow, PersonRow, WorklistRow, AttachmentRow, AttachmentVersion, GridColumn, GridRow, DesignElement, Metric } from "models.slint";
export { App, NavRow, PageTab, DataRow, FormField, FormSection, OrganizationRow, PersonRow, WorklistRow, AttachmentRow, AttachmentVersion, GridColumn, GridRow, DesignElement, Metric }
import { Theme, ActionButton, Card, Badge } from "theme.slint";
import { Navigation } from "navigation.slint";
import { RecordsPage } from "records.slint";
import { InvoicePage } from "invoice.slint";
import { PaymentPage } from "payment.slint";
import { OrganizationPage } from "organization.slint";
import { PeoplePage, PersonnelPage } from "personnel.slint";
import { BusinessPage } from "business.slint";
import { WorklistPage, DashboardPage } from "workspace.slint";
import { AttachmentsPage } from "attachments.slint";
import { DesignerPage } from "designer.slint";
import { FormView, FormSections } from "forms.slint";
import { SettingsPage } from "settings.slint";
import { ExcelPage, ImportPreview } from "excel.slint";
import { PdfView } from "pdf.slint";
import { DocumentPackagePanel } from "document-package.slint";
export { DocumentPackage } from "document-package-models.slint";
import { OfficePage } from "office.slint";
import { BackupPage } from "maintenance.slint";
import { AccessPage } from "access.slint";
export { Access, PermissionRow } from "access-models.slint";
import { AuditPage } from "audit.slint";
export { Audit } from "audit-models.slint";
import { ExchangePage } from "exchange.slint";
export { Exchange } from "exchange.slint";
import { SalesPage } from "sales.slint";
export { Sales, SalesHistoryRow } from "sales-models.slint";
import { PartyImportPage } from "party-files.slint";
export { PartyFiles } from "party-files.slint";
import { SalesDashboardPage } from "crm.slint";
export { Crm } from "crm.slint";
import { SupplierOverviewPage } from "supplier-overview.slint";
export { SupplierOverview } from "supplier-overview.slint";
import { OcrPage } from "ocr.slint";
export { Ocr, OcrLine } from "ocr.slint";
import { MailPage } from "mail.slint";
export { Mail, MailVariable } from "mail-models.slint";
import { HsPage } from "hs.slint";
export { Hs } from "hs-models.slint";
import { PackingPage } from "packing.slint";
export { Packing, PackingCargo } from "packing-models.slint";
import { SingleWindowPage, ProducerDialog } from "single-window.slint";
import { SingleWindow } from "single-window-models.slint";
import { QueryPage, InvoicePackageDialog } from "query.slint";
import { PdfMergePage } from "pdf-merge.slint";
export { PdfMerge } from "pdf-merge.slint";
import { Query, InvoiceFiles } from "document-files-models.slint";
export { Query, InvoiceFiles }
import { License } from "license-models.slint";
export { License }
import { LicensePanel } from "license.slint";
import { Recovery } from "recovery-models.slint";
export { Recovery }
import { TemplateFiles, TemplateFileRow } from "template-files-models.slint";
export { TemplateFiles, TemplateFileRow }
export { SingleWindow }
export component AppWindow inherits Window {
    title:"外贸业务综合管理系统（全功能版）";
    preferred-width:1440px;preferred-height:920px;min-width:980px;min-height:680px;
    default-font-family:"Noto Sans CJK SC";default-font-size:13px;
    background:Theme.background;
    if !App.logged-in:Rectangle {
        background:#edf6f1;
        Card {x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:450px;height:410px;
            VerticalLayout {padding:32px;spacing:18px;
                Text{text:"外贸业务综合管理系统";font-size:24px;font-weight:700;color:Theme.ink;height:34px;}
                Text{text:"登录工作区";font-size:14px;color:Theme.muted;height:24px;}
                username:=LineEdit{text:"admin";placeholder-text:"账号";accessible-label:"账号";height:40px;}
                password:=LineEdit{input-type:InputType.password;placeholder-text:"密码";accessible-label:"密码";height:40px;accepted=>{App.login(username.text,self.text);}}
                ActionButton{text:App.busy?"正在登录…":"登 录";primary:true;height:40px;enabled:!App.busy;clicked=>{App.login(username.text,password.text);}}
                Text{text:App.error;color:Theme.error;wrap:word-wrap;min-height:38px;}
                Text{text:"单机首次使用：admin，密码为空";color:Theme.muted;font-size:12px;height:22px;}
            }
        }
    }
    if App.logged-in:HorizontalLayout {padding:0px;spacing:0px;
        if !App.workbench:Navigation{}
        VerticalLayout {padding:0px;spacing:0px;
            Rectangle {height:App.workbench?64px:100px;background:white;
                Rectangle{y:parent.height - 1px;height:1px;background:Theme.line;}
                HorizontalLayout {padding-left:20px;padding-right:20px;padding-top:14px;padding-bottom:14px;spacing:14px;
                    VerticalLayout {padding:0px;spacing:6px;
                        if !App.workbench:Text{text:App.group-label;font-size:12px;font-weight:700;color:Theme.primary;}
                        Text{text:App.page=="invoice-edit"?App.invoice-title:App.page=="payment-edit"?App.payment-title:App.title;font-size:24px;font-weight:700;color:Theme.ink;}
                        if !App.workbench:Text{text:App.description;font-size:12px;color:Theme.muted;}
                    }
                    Rectangle{horizontal-stretch:1;}
                    Badge{text:App.busy?"正在处理":"● 服务已连接";}
                    if App.busy:ActionButton{text:"取消操作";clicked=>{App.cancel-operation();}}
                    Badge{text:App.user-name;}
                    ActionButton{text:"关于";clicked=>{App.navigate("about");}}
                    ActionButton{text:"退出";clicked=>{App.logout();}}
                }
            }
            if App.error!="":Rectangle {height:48px;background:#fff3ef;
                HorizontalLayout{padding:12px;spacing:12px;
                    Text{text:App.error;color:Theme.error;wrap:word-wrap;horizontal-stretch:1;vertical-alignment:center;accessible-live-region:assertive;}
                    ActionButton{text:"关闭提示";clicked=>{App.error="";}}
                }
            }
            Rectangle {vertical-stretch:1;accessible-role:main;accessible-label:App.title;
                Rectangle {x:20px;y:18px;width:parent.width - 40px;height:parent.height - 36px;
                    background:transparent;
                    if App.page=="invoice-edit":InvoicePage{}
                    if App.page=="query":QueryPage{}
                    if App.page=="pdf-merge":PdfMergePage{}
                    if App.page=="payment-edit":PaymentPage{}
                    if App.page=="organization":OrganizationPage{}
                    if App.page=="people":PeoplePage{}
                    if App.page=="personnel":PersonnelPage{}
                    if App.page=="office":OfficePage{}
                    if App.page=="backup":BackupPage{}
                    if App.page=="access":AccessPage{}
                    if App.page=="audit":AuditPage{}
                    if App.page=="exchange":ExchangePage{}
                    if App.page=="sales":SalesPage{}
                    if App.page=="packing":PackingPage{}
                    if App.page=="hs":HsPage{}
                    if App.page=="mail":MailPage{}
                    if App.page=="ocr":OcrPage{}
                    if App.page=="single-window":SingleWindowPage{}
                    if App.page=="party-import":PartyImportPage{}
                    if App.page=="sales-dashboard":SalesDashboardPage{}
                    if App.page=="supplier-overview":SupplierOverviewPage{}
                    if App.page=="business":BusinessPage{}
                    if App.page=="worklist":WorklistPage{}
                    if App.page=="dashboard":DashboardPage{}
                    if App.page=="attachments":AttachmentsPage{}
                    if App.page=="records":RecordsPage{}
                    if App.page=="designer":DesignerPage{}
                    if App.page=="settings":SettingsPage{}
                    if App.page=="excel":ExcelPage{}
                    if App.page=="payment-report":Card{PdfView{}}
                    if App.page=="document-package":DocumentPackagePanel{}
                    if App.page=="about":Card {
                        VerticalLayout {padding:24px;spacing:14px;
                            HorizontalLayout {height:36px;spacing:8px;
                                ActionButton {text:"关于系统";active:App.about-tab==0;clicked=>{App.about-tab=0;}}
                                ActionButton {text:"授权注册";active:App.about-tab==1;clicked=>{App.about-tab=1;}}
                                Rectangle{horizontal-stretch:1;}
                            }
                            if App.about-tab==0:ScrollView{content-width:self.visible-width;VerticalLayout {padding:8px;spacing:18px;alignment:start;
                                Text{text:"外贸业务综合管理系统";font-size:26px;font-weight:700;color:Theme.ink;}
                                Text{text:"全功能版 · Rust + Slint 原生桌面";font-size:16px;color:Theme.primary;}
                                Text{text:"网页端和 Docker 版继续使用 React。\n桌面数据保存在程序运行目录内的 SQLite 数据库中。\n软件第三方许可随安装包提供。";wrap:word-wrap;color:Theme.muted;font-size:14px;min-height:80px;}
                                AboutSlint {preferred-height:220px;}
                            }}
                            if App.about-tab==1:LicensePanel{}
                        }
                    }
                }
            }
            Rectangle{height:29px;background:white;HorizontalLayout{padding-left:20px;padding-right:20px;
                Text{text:App.status;color:Theme.muted;font-size:11px;vertical-alignment:center;horizontal-stretch:1;accessible-live-region:polite;}
                Text{text:"外贸业务综合管理系统";color:Theme.muted;font-size:11px;vertical-alignment:center;}
            }}
        }
    }
    if App.form-open:Rectangle {
        background:#092d2870;TouchArea{}
        Card {x:(parent.width - self.width)/2;y:40px;width:min(1060px,parent.width - 80px);height:parent.height - 80px;
            VerticalLayout{padding:20px;spacing:12px;
                Text{text:App.form-title;color:Theme.ink;font-size:20px;font-weight:700;height:30px;}
                if App.form-sections.length==0:FormView{fields:App.fields;enabled:!App.busy;edited(key,value)=>{App.field-edited(key,value);}selected(key,index)=>{App.field-selected(key,index);}array-action(key,action)=>{App.array-action(key,action);}}
                if App.form-sections.length>0:FormSections{sections:App.form-sections;enabled:!App.busy;toggled(key)=>{App.toggle-form-section(key);}edited(key,value)=>{App.field-edited(key,value);}selected(key,index)=>{App.field-selected(key,index);}array-action(key,action)=>{App.array-action(key,action);}}
                if App.form-error!="":Text{text:App.form-error;color:Theme.error;wrap:word-wrap;min-height:30px;}
                HorizontalLayout{height:36px;alignment:end;spacing:8px;
                    ActionButton{text:"取消";enabled:!App.busy;clicked=>{App.cancel-form();}}
                    ActionButton{text:"保存";primary:true;enabled:!App.busy;clicked=>{App.save-form();}}
                }
            }
        }
    }
    if App.columns-open:Rectangle{
        background:#092d2870;TouchArea{}
        Card{x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:660px;height:min(690px,parent.height - 60px);
            VerticalLayout{padding:22px;spacing:14px;
                Text{text:"商品明细 · 显示列";font-size:20px;color:Theme.ink;font-weight:700;height:30px;}
                ScrollView{content-width:self.visible-width;VerticalLayout{spacing:8px;
                    for row in ceil(App.all-columns.length/3):HorizontalLayout{height:32px;spacing:10px;
                        for col in 3:CheckBox{
                            visible:row*3+col<App.all-columns.length;
                            text:App.all-columns[row*3+col].label;
                            checked:App.all-columns[row*3+col].visible;
                            toggled=>{App.column-visible(row*3+col,self.checked);}
                        }
                    }
                }}
                ActionButton{text:"完成";primary:true;clicked=>{App.columns-open=false;}}
            }
        }
    }
    if App.import-open:ImportPreview{}
    if InvoiceFiles.open:InvoicePackageDialog{}
    if SingleWindow.producers-open:ProducerDialog{}
    if App.confirm-open:Rectangle{
        background:#092d2870;TouchArea{}
        Card{x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:500px;height:240px;
            VerticalLayout{padding:24px;spacing:16px;
                Text{text:"请确认";font-size:20px;color:Theme.ink;font-weight:700;}
                Text{text:App.confirm-message;color:Theme.ink;wrap:word-wrap;vertical-stretch:1;}
                HorizontalLayout{height:36px;alignment:end;spacing:8px;
                    ActionButton{text:"取消";clicked=>{App.confirm(false);}}
                    ActionButton{text:"确认";primary:true;clicked=>{App.confirm(true);}}
                }
            }
        }
    }
}
