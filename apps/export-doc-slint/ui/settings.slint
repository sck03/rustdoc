import { CheckBox } from "std-widgets.slint";
import { Mail } from "mail-models.slint";
import { App } from "models.slint";
import { Theme, ActionButton, Card } from "theme.slint";
import { FormSections } from "forms.slint";
import { LicensePanel } from "license.slint";
export component SettingsPage inherits Rectangle {
    background:transparent;
    VerticalLayout {padding:0px;spacing:14px;
        HorizontalLayout {height:36px;spacing:10px;
            Text{text:App.storage-summary;font-size:13px;color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
            if App.settings-category=="backup":ActionButton{text:"备份文件";clicked=>{App.open-tab("backup");}}
            if App.settings-category=="communication":ActionButton{text:"推断服务器";enabled:!App.busy;clicked=>{Mail.action("suggestion",0);}}
            if App.settings-category=="communication":ActionButton{text:"发送测试邮件";enabled:!App.busy;clicked=>{Mail.action("test",0);}}
            ActionButton{text:"保存全部修改";primary:true;enabled:!App.busy;clicked=>{App.save-form();}}
        }
        HorizontalLayout {spacing:14px;
            Card {width:168px;VerticalLayout {padding:12px;spacing:8px;alignment:start;
                for category in App.settings-categories:ActionButton {
                    text:category.label;active:category.key==App.settings-category;
                    clicked=>{App.settings-category-selected(category.key);}
                }
            }}
            if App.settings-category=="license":Card{horizontal-stretch:1;LicensePanel{}}
            if App.settings-category!="license":Card {FormSections{sections:App.form-sections;enabled:!App.busy;toggled(key)=>{App.toggle-form-section(key);}edited(key,value)=>{App.field-edited(key,value);}selected(key,index)=>{App.field-selected(key,index);}array-action(key,action)=>{App.array-action(key,action);}}}
        }
        if App.settings-category=="communication"||App.settings-category=="ai"||App.settings-category=="backup":HorizontalLayout {height:32px;spacing:12px;
            CheckBox {text:"更新已填写的密码／密钥（留空保留）";checked <=> App.settings-update-secrets;}
            Text {text:App.settings-secret-summary;color:Theme.muted;vertical-alignment:center;horizontal-stretch:1;}
        }
        if App.form-error!="":Text{text:App.form-error;color:Theme.error;wrap:word-wrap;min-height:36px;}
    }
}