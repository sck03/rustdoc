import { DataRow, FormSection } from "models.slint";
export global Hs {
    in-out property <int> tab:0;
    in-out property <string> query;
    in-out property <[DataRow]> rows;
    in-out property <[string]> columns;
    in-out property <int> selected:0;
    in-out property <int> page:1;
    in-out property <int> total-pages:1;
    in-out property <string> summary;
    in-out property <string> details;
    in-out property <bool> can-remote;
    in-out property <bool> can-confirm;
    in-out property <bool> can-manage;
    in-out property <bool> can-feedback;
    in-out property <bool> can-use;
    in-out property <bool> editor:false;
    in-out property <bool> editing-code:false;
    in-out property <[FormSection]> sections;
    in-out property <string> form-error;
    in-out property <string> invalid-field;
    in-out property <bool> multi:false;
    in-out property <int> checked-count:0;
    in-out property <int> candidate-status:0;
    in-out property <string> current-code;
    in-out property <string> source-name;
    in-out property <string> year;
    in-out property <int> import-mode:0;
    in-out property <string> import-summary;
    in-out property <bool> preview-ready:false;
    in-out property <string> since;
    callback action(string,int);
    callback edited(string,string);
    callback chosen(string,int);
}
