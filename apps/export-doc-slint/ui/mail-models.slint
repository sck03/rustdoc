import { DataRow } from "models.slint";
export struct MailVariable {key:string,label:string,value:string,token:string}
export global Mail {
    in-out property <int> tab:0;
    in-out property <int> template-tab:0;
    in-out property <string> status;
    in-out property <bool> configured:false;
    in-out property <bool> can-send:false;
    in-out property <bool> can-configure:false;
    in-out property <bool> can-view-deliveries:false;
    in-out property <bool> can-view-templates:false;
    in-out property <bool> can-create:false;
    in-out property <bool> can-edit:false;
    in-out property <bool> can-publish:false;
    in-out property <bool> can-share:false;
    in-out property <bool> can-disable:false;
    in-out property <bool> can-restore:false;
    in-out property <bool> can-archive:false;
    in-out property <bool> can-undo:false;
    in-out property <bool> can-redo:false;
    in-out property <string> to;
    in-out property <string> subject;
    in-out property <string> body;
    in-out property <bool> rich-body:false;
    in-out property <bool> source-mode:false;
    in-out property <[string]> attachments;
    in-out property <string> keyword;
    in-out property <int> status-index:0;
    in-out property <int> page:1;
    in-out property <int> total-pages:1;
    in-out property <int> selected:0;
    in-out property <[DataRow]> rows;
    in-out property <string> details;
    in-out property <bool> include-archived:false;
    in-out property <int> template-scope:0;
    in-out property <int> share-scope:0;
    in-out property <int> template-selected:0;
    in-out property <[DataRow]> template-rows;
    in-out property <string> name;
    in-out property <string> category;
    in-out property <string> template-subject;
    in-out property <string> template-body;
    in-out property <string> template-status;
    in-out property <[MailVariable]> variables;
    in-out property <[DataRow]> versions;
    in-out property <int> version-selected:0;
    in-out property <string> version-detail;
    in-out property <string> customer-keyword;
    in-out property <[string]> customers;
    in-out property <int> customer-index:-1;
    in-out property <string> preview-subject;
    in-out property <string> preview-body;
    in-out property <string> unresolved;
    callback action(string,int);
    callback edited(string,string);
}
