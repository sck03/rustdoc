import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, ActionButton, Card } from "theme.slint";
import { FormView } from "forms.slint";
import { TemplateFiles } from "template-files-models.slint";
import { TemplateFilesPanel } from "template-files.slint";
export component DesignerPage inherits Rectangle {
    background:transparent;
    VerticalLayout {padding:0px;spacing:12px;
        HorizontalLayout {height:36px;spacing:7px;
            ActionButton{text:"← 模板管理";clicked=>{App.navigate("report-templates");}}
            ActionButton{text:"模板文件";active:TemplateFiles.open;clicked=>{TemplateFiles.action("toggle");}}
            LineEdit{text<=>App.template-name;horizontal-stretch:1;}
            ActionButton{text:"撤销";clicked=>{App.designer-action("undo");}}
            ActionButton{text:"重做";clicked=>{App.designer-action("redo");}}
            ActionButton{text:"保存";primary:true;enabled:!App.busy;clicked=>{App.designer-action("save");}}
            ActionButton{text:"发布";enabled:App.template-saved&&!App.busy;clicked=>{App.designer-action("publish");}}
        }
        HorizontalLayout {spacing:12px;
            if TemplateFiles.open:Card {width:352px;TemplateFilesPanel{}}
            Card {width:170px;VerticalLayout{padding:12px;spacing:9px;
                Text{text:"添加元素";font-weight:700;color:Theme.ink;height:24px;}
                for action in ["文字","字段","线条","矩形","明细表"]:ActionButton{text:action;clicked=>{App.designer-action(action);} }
                Rectangle{height:1px;background:Theme.line;}
                Text{text:"字段绑定";color:Theme.muted;height:24px;}
                ComboBox{model:App.binding-fields;current-index<=>App.binding-index;}
                ActionButton{text:"绑定选中元素";clicked=>{App.designer-action("bind");}}
                ActionButton{text:"删除元素";clicked=>{App.designer-action("delete");}}
                Rectangle{vertical-stretch:1;}
                Text{text:"拖动元素调整位置\n方向键微调\n坐标与 PDF 共用";wrap:word-wrap;color:Theme.muted;font-size:12px;min-height:54px;}
            }}
            Rectangle {background:#dce7e3;horizontal-stretch:1;
                ScrollView {
                    content-width:max(self.visible-width,660px);
                    content-height:950px;
                    page:=Rectangle {
                        x:24px;y:20px;width:630px;height:891px;background:white;
                        for item in App.design-elements: Rectangle {
                            property <length> dx:0px;property <length> dy:0px;
                            x:item.x*0.03px+self.dx;y:item.y*0.03px+self.dy;
                            width:item.w*0.03px;height:item.h*0.03px;
                            border-width:item.selected?2px:item.kind=="矩形"||item.kind=="商品明细表"?1px:0px;
                            border-color:item.selected?Theme.primary:#839a91;background:item.kind=="商品明细表"?#f4f8f6:transparent;
                            Text{x:3px;width:parent.width - 6px;text:item.text;color:Theme.ink;font-size:max(10px,item.font-size*1.25px);wrap:word-wrap;vertical-alignment:center;}
                            if item.kind=="线条":Rectangle{y:parent.height/2;height:1px;background:Theme.ink;}
                            touch:=TouchArea {
                                property <length> start-x;property <length> start-y;
                                mouse-cursor:move;
                                pointer-event(e)=>{
                                    if(e.kind==PointerEventKind.down){self.start-x=self.mouse-x;self.start-y=self.mouse-y;App.designer-select(item.id);}
                                    if(e.kind==PointerEventKind.up){App.designer-move(item.id,parent.dx/0.03px,parent.dy/0.03px,true);parent.dx=0px;parent.dy=0px;}
                                }
                                moved=>{if(self.pressed){parent.dx+=self.mouse-x - self.start-x;parent.dy+=self.mouse-y - self.start-y;}}
                            }
                        }
                    }
                }
            }
            Card {width:270px;FormView{fields:App.design-fields;column-count:1;edited(key,value)=>{App.designer-field(key,value);} }}
        }
    }
}