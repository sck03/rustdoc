import { ScrollView, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { App } from "models.slint";
import { Hs } from "hs-models.slint";
import { Theme, ActionButton, Card } from "theme.slint";
import { FormSections } from "forms.slint";
import { RecordTable } from "data-table.slint";
export component HsPage inherits VerticalLayout {
    padding:0px;spacing:10px;
    HorizontalLayout {spacing:7px;alignment:start;
        for title[i] in ["知识检索","税则主档","申报案例","历史学习","联网候选","知识迁移","联网查询"]:ActionButton{text:title;primary:Hs.tab==i;enabled:!App.busy&&(i!=6||Hs.can-remote);clicked=>{Hs.action("tab",i);}}
    }
    if Hs.editor:Card {vertical-stretch:1;
        VerticalLayout{padding:12px;spacing:8px;
            HorizontalLayout {spacing:8px;alignment:start;
                Text{text:Hs.editing-code?"维护税则资料":"编辑申报案例";font-weight:700;font-size:18px;color:Theme.ink;horizontal-stretch:1;}
                ActionButton{text:"保存";primary:true;enabled:Hs.can-manage&&!App.busy;clicked=>{Hs.action("save",0);}}
                ActionButton{text:"取消";enabled:!App.busy;clicked=>{Hs.action("cancel-editor",0);}}
            }
            if Hs.editing-code:Text{text:"手工新建作为参考资料；当前有效税则须通过年度文件或知识包建立。";color:Theme.muted;wrap:word-wrap;min-height:26px;}
            if Hs.form-error!="":Text{text:Hs.form-error;color:Theme.error;wrap:word-wrap;min-height:28px;}
            FormSections{sections:Hs.sections;editable:Hs.can-manage;enabled:!App.busy;invalid-key:Hs.invalid-field;
                edited(key,value)=>{Hs.edited(key,value);}selected(key,index)=>{Hs.chosen(key,index);}toggled(key)=>{Hs.action(key,0);}}
        }
    }
    if !Hs.editor:VerticalLayout {spacing:10px;
        if Hs.tab!=5:HorizontalLayout{spacing:8px;height:38px;
            LineEdit{text <=> Hs.query;placeholder-text:Hs.tab==0?"商品名称、材质、用途、规格或至少 4 位编码":"编码、品名或规格";horizontal-stretch:1;accepted=>{Hs.action("search",0);}}
            if Hs.tab==4:ComboBox{model:["待审核","已确认","已忽略"];current-index <=> Hs.candidate-status;selected=>{Hs.action("search",0);}}
            ActionButton{text:Hs.tab==6?"查询并收集候选":"查询";primary:true;enabled:!App.busy;clicked=>{Hs.action("search",0);}}
            if Hs.tab==1||Hs.tab==2:ActionButton{text:"新增";enabled:Hs.can-manage&&!App.busy;clicked=>{Hs.action("new",0);}}
        }
        if Hs.tab==5:Card{height:188px;
            VerticalLayout{padding:12px;spacing:10px;alignment:start;
                Text{text:"年度税则导入";font-weight:700;font-size:17px;color:Theme.ink;}
                HorizontalLayout{spacing:8px;
                    ComboBox{model:["增量导入","完整年度库"];current-index <=> Hs.import-mode;}
                    LineEdit{text <=> Hs.source-name;placeholder-text:"可信数据来源";horizontal-stretch:1;}
                    LineEdit{text <=> Hs.year;placeholder-text:"适用年度";width:120px;}
                    ActionButton{text:"选择文件并预检";enabled:Hs.can-manage&&!App.busy;clicked=>{Hs.action("preview-tariff",0);}}
                    ActionButton{text:"确认导入";primary:true;enabled:Hs.can-manage&&Hs.preview-ready&&!App.busy;clicked=>{Hs.action("commit-tariff",0);}}
                }
                Text{text:Hs.import-summary;color:Theme.muted;wrap:word-wrap;min-height:26px;}
                HorizontalLayout{spacing:8px;
                    LineEdit{text <=> Hs.since;placeholder-text:"增量导出起始时间（含时区，留空导出全部）";horizontal-stretch:1;}
                    ActionButton{text:"导出知识包";enabled:Hs.can-manage&&!App.busy;clicked=>{Hs.action("export-package",0);}}
                    ActionButton{text:"导入知识包";enabled:Hs.can-manage&&!App.busy;clicked=>{Hs.action("import-package",0);}}
                }
            }
        }
        if Hs.tab==1||Hs.tab==2||Hs.tab==4:HorizontalLayout{spacing:8px;height:32px;alignment:start;
            CheckBox{text:"批量选择";checked <=> Hs.multi;}
            ActionButton{text:"选择本页";clicked=>{Hs.action("select-page",0);}}
            ActionButton{text:"清除选择";clicked=>{Hs.action("select-none",0);}}
            Text{text:"已选 "+Hs.checked-count+" 条";color:Theme.muted;vertical-alignment:center;}
            Rectangle{horizontal-stretch:1;}
            if Hs.tab==1||Hs.tab==2:ActionButton{text:"删除所选";enabled:Hs.can-manage&&Hs.checked-count>0&&!App.busy;clicked=>{Hs.action("delete-batch",0);}}
            if Hs.tab==4:ActionButton{text:"忽略所选";enabled:Hs.can-manage&&Hs.checked-count>0&&!App.busy;clicked=>{Hs.action("ignore-batch",0);}}
            if Hs.tab==4:ActionButton{text:"重置所选";enabled:Hs.can-manage&&Hs.checked-count>0&&!App.busy;clicked=>{Hs.action("reset-batch",0);}}
        }
        Card {vertical-stretch:2;min-height:180px;
            RecordTable{columns:Hs.columns;rows:Hs.rows;selected-id:Hs.selected;busy:App.busy;
                selected(index)=>{Hs.action("select",index);}opened(index)=>{Hs.action("open",index);}}
        }
        HorizontalLayout{height:32px;spacing:8px;
            Text{text:Hs.summary;color:Theme.muted;wrap:word-wrap;horizontal-stretch:1;}
            ActionButton{text:"上一页";enabled:Hs.page>1&&!App.busy;clicked=>{Hs.action("page",-1);}}
            Text{text:Hs.page+" / "+Hs.total-pages;vertical-alignment:center;color:Theme.muted;}
            ActionButton{text:"下一页";enabled:Hs.page<Hs.total-pages&&!App.busy;clicked=>{Hs.action("page",1);}}
        }
        Card {vertical-stretch:1;min-height:135px;
            VerticalLayout {padding:12px;spacing:8px;
                ScrollView{content-width:self.visible-width;Text{text:Hs.details;color:Theme.ink;wrap:word-wrap;}}
                HorizontalLayout {spacing:8px;alignment:start;
                    if Hs.tab==0:ActionButton{text:"确认适用";enabled:Hs.can-feedback&&Hs.can-use&&Hs.selected>0&&!App.busy;clicked=>{Hs.action("accept",0);}}
                    if Hs.tab==0:ActionButton{text:"不适用";enabled:Hs.can-feedback&&Hs.selected>0&&!App.busy;clicked=>{Hs.action("reject",0);}}
                    if Hs.tab==1||Hs.tab==2:ActionButton{text:"编辑 / 查看";enabled:Hs.selected>0&&!App.busy;clicked=>{Hs.action("open",Hs.selected);}}
                    if Hs.tab==3:ActionButton{text:"确认并建立案例";enabled:Hs.can-manage&&Hs.can-confirm&&Hs.selected>0&&!App.busy;clicked=>{Hs.action("learn",0);}}
                    if Hs.tab==4:LineEdit{text <=> Hs.current-code;placeholder-text:"确认适用的当前有效编码";width:240px;}
                    if Hs.tab==4:ActionButton{text:"确认候选";enabled:Hs.can-manage&&Hs.selected>0&&!App.busy;clicked=>{Hs.action("confirm-candidate",0);}}
                    if Hs.tab==6:ActionButton{text:"读取详情";enabled:Hs.selected>0&&!App.busy;clicked=>{Hs.action("remote-detail",0);}}
                    if Hs.tab==6:ActionButton{text:"保存为本地参考";enabled:Hs.can-manage&&Hs.selected>0&&!App.busy;clicked=>{Hs.action("reference",0);}}
                }
            }
        }
    }
}
