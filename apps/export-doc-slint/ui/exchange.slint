import { ScrollView } from "std-widgets.slint";
import { App } from "models.slint";
import { Theme, ActionButton, Card } from "theme.slint";
import { DataTable } from "data-table.slint";
export global Exchange {
    in-out property <string> source:"中国银行汇率源";
    in-out property <string> fetched;
    in-out property <string> currencies;
    in-out property <string> summary:"未获取";
    callback action(string);
}
export component ExchangePage inherits VerticalLayout {
    padding:0px;spacing:12px;
    Card{height:100px;HorizontalLayout{padding:16px;spacing:12px;
        VerticalLayout{padding:0px;spacing:8px;horizontal-stretch:1;
            Text{text:Exchange.summary;font-size:20px;font-weight:700;color:Theme.ink;}
            Text{text:Exchange.source;color:Theme.muted;overflow:elide;}
            Text{text:Exchange.fetched;color:Theme.muted;font-size:12px;}
        }
        ActionButton{text:"读取可用币种";enabled:!App.busy;clicked=>{Exchange.action("currencies");}}
        ActionButton{text:"刷新汇率";enabled:!App.busy;clicked=>{Exchange.action("refresh");}}
        ActionButton{text:"强制刷新";primary:true;enabled:!App.busy;clicked=>{Exchange.action("force");}}
    }}
    if Exchange.currencies!="":Card{height:80px;ScrollView{content-width:self.visible-width;
        Text{x:14px;y:12px;width:parent.width - 28px;text:"币种："+Exchange.currencies;color:Theme.muted;wrap:word-wrap;}
    }}
    Card{VerticalLayout{padding:14px;spacing:12px;
        DataTable{}
        Text{text:"报价单位：人民币元 / 100 外币。空白表示汇率源未提供该项报价。";color:Theme.muted;wrap:word-wrap;min-height:25px;}
        Text{text:"币种和缓存时间可在系统设置中调整，查询结果仅保存在本次运行的内存中。";color:Theme.muted;wrap:word-wrap;min-height:25px;}
    }}
}
