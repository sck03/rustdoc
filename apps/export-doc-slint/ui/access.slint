import { ScrollView, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { App } from "models.slint";
import { Access } from "access-models.slint";
import { Theme, ActionButton, Card, Badge } from "theme.slint";
export component AccessPage inherits VerticalLayout {
    padding:0px;spacing:12px;
    HorizontalLayout{height:36px;spacing:8px;alignment:start;
        for tab in App.tabs:ActionButton{text:tab.label;active:tab.key==App.resource;enabled:!App.busy;clicked=>{App.open-tab(tab.key);}}
        Rectangle{horizontal-stretch:1;}
        ActionButton{text:"组织架构";clicked=>{App.navigate("companies");}}
    }
    HorizontalLayout{spacing:14px;
        Card{width:220px;
            VerticalLayout{padding:12px;spacing:10px;
                Text{text:"权限方案";font-size:16px;font-weight:700;color:Theme.ink;height:25px;}
                HorizontalLayout{spacing:6px;
                    ActionButton{text:"新建";enabled:!App.busy;clicked=>{Access.access-action("new","");}}
                    ActionButton{text:"刷新";enabled:!App.busy;clicked=>{Access.access-action("refresh","");}}
                }
                ScrollView{content-width:self.visible-width;
                    VerticalLayout{padding:0px;spacing:6px;
                        for item in Access.access-templates:ActionButton{text:item.label;left-aligned:true;horizontal-stretch:1;min-width:0px;
                            active:item.key==""+Access.access-id;enabled:!App.busy;clicked=>{Access.access-action("select",item.key);}}
                    }
                }
            }
        }
        Card{
            VerticalLayout{padding:16px;spacing:10px;
                HorizontalLayout{height:36px;spacing:12px;
                    LineEdit{placeholder-text:"方案代码";accessible-label:"方案代码";text<=>Access.access-code;enabled:!Access.access-system&&!App.busy;edited=>{Access.access-field("code",self.text);}}
                    LineEdit{placeholder-text:"方案名称";accessible-label:"方案名称";text<=>Access.access-name;enabled:!Access.access-read-only&&!App.busy;horizontal-stretch:1;edited=>{Access.access-field("name",self.text);}}
                    CheckBox{text:"启用";checked<=>Access.access-active;enabled:!Access.access-system&&!App.busy;toggled=>{Access.access-field("isActive",self.checked?"true":"false");}}
                    ActionButton{text:"复制方案";enabled:!App.busy;clicked=>{Access.access-action("copy","");}}
                }
                LineEdit{text<=>Access.access-description;placeholder-text:"岗位职责和方案说明";accessible-label:"方案说明";enabled:!Access.access-read-only&&!App.busy;edited=>{Access.access-field("description",self.text);}}
                Text{text:Access.access-summary;color:Theme.muted;wrap:word-wrap;min-height:32px;}
                HorizontalLayout{height:36px;spacing:10px;
                    LineEdit{text<=>Access.access-search;placeholder-text:"搜索页面、模块或动作";input-type:InputType.search;accessible-label:"搜索权限模块";horizontal-stretch:1;edited=>{Access.access-action("search",self.text);}}
                    ComboBox{current-index<=>Access.access-workspace-index;model:["全部业务","单证业务","销售业务","公司行政","通用功能"];selected=>{Access.access-action("workspace",self.current-index==1?"document":self.current-index==2?"sales":self.current-index==3?"office":self.current-index==4?"common":"");}}
                    Text{text:"快捷授权范围";color:Theme.muted;vertical-alignment:center;}
                    ComboBox{model:["本人","部门","公司","全部"];current-index<=>Access.access-scope;width:95px;}
                }
                ScrollView{content-width:self.visible-width;
                    VerticalLayout{padding:0px;spacing:0px;
                        for row in Access.access-rows:Rectangle{
                            height:row.group?52px:60px;background:row.group?Theme.soft:white;
                            Rectangle{y:parent.height - 1px;height:1px;background:Theme.line;}
                            HorizontalLayout{padding-left:12px;padding-right:12px;spacing:12px;alignment:start;
                                VerticalLayout{padding-top:8px;padding-bottom:8px;spacing:4px;horizontal-stretch:1;
                                    Text{text:row.label;color:Theme.ink;font-weight:row.group?700:500;font-size:row.group?14px:13px;}
                                    Text{text:row.detail;color:Theme.muted;font-size:11px;overflow:elide;}
                                }
                                if row.group:HorizontalLayout{spacing:6px;alignment:center;
                                    ActionButton{text:"关闭";enabled:!Access.access-read-only&&!App.busy;clicked=>{Access.access-action("preset:",row.key);}}
                                    ActionButton{text:"仅查看";enabled:!Access.access-read-only&&!App.busy;clicked=>{Access.access-action("preset:view",row.key);}}
                                    ActionButton{text:"日常操作";enabled:!Access.access-read-only&&!App.busy;clicked=>{Access.access-action("preset:operate",row.key);}}
                                    ActionButton{text:"完整管理";enabled:!Access.access-read-only&&!App.busy;clicked=>{Access.access-action("preset:manage",row.key);}}
                                }
                                if !row.group:ComboBox{width:110px;model:row.supports-scope?["未开放","本人","部门","公司","全部"]:["未开放","开放"];
                                    current-index:row.supports-scope?row.scope:(row.scope>0?1:0);enabled:!Access.access-read-only&&!App.busy;
                                    selected=>{Access.access-grant(row.key,row.supports-scope?self.current-index:(self.current-index>0?4:0));}}
                                if !row.group:Text{text:row.effective;color:Theme.muted;width:205px;wrap:word-wrap;vertical-alignment:center;font-size:12px;}
                            }
                        }
                        if Access.access-rows.length==0:Text{text:"没有匹配的业务模块";color:Theme.muted;min-height:70px;}
                        if Access.access-dependencies!="":Text{text:"自动生效的技术依赖\n"+Access.access-dependencies;color:Theme.muted;wrap:word-wrap;min-height:50px;}
                    }
                }
                HorizontalLayout{height:36px;spacing:8px;
                    ActionButton{text:"保存方案";primary:true;enabled:!Access.access-read-only&&!App.busy;clicked=>{Access.access-action("save","");}}
                    ActionButton{text:"取消修改";enabled:!App.busy;clicked=>{Access.access-action("cancel","");}}
                    ActionButton{text:"删除方案";enabled:Access.access-id>0&&!Access.access-system&&!App.busy;clicked=>{Access.access-action("delete","");}}
                    if Access.access-read-only:Badge{text:"系统管理员方案只读";}
                    Rectangle{horizontal-stretch:1;}
                }
            }
        }
    }
}
