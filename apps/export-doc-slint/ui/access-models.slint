import { PageTab } from "models.slint";
export struct PermissionRow { key:string, label:string, detail:string, group:bool, scope:int, supports-scope:bool, effective:string }
export global Access {
    in-out property <[PageTab]> access-templates;
    in-out property <[PermissionRow]> access-rows;
    in-out property <int> access-id:0;
    in-out property <int> access-scope:0;
    in-out property <int> access-workspace-index:0;
    in-out property <string> access-search;
    in-out property <string> access-code;
    in-out property <string> access-name;
    in-out property <string> access-description;
    in-out property <string> access-summary;
    in-out property <string> access-dependencies;
    in-out property <bool> access-active:true;
    in-out property <bool> access-system:false;
    in-out property <bool> access-read-only:false;
    callback access-action(string,string);
    callback access-field(string,string);
    callback access-grant(string,int);
}
