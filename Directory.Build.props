<Project>
  <PropertyGroup>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1</InformationalVersion>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!-- Capability assemblies are intentionally removable from each edition, so publish output must remain multi-file. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Normal builds stay portable. Release scripts pass an explicit RID and consume a
         committed per-RID graph without restoring unrelated platform packs. The core desktop
         edition has a separate API graph because its optional capability projects are absent. -->
    <ExportDocRuntimeRestore Condition="'$(ExportDocRuntimeRestore)' == ''">false</ExportDocRuntimeRestore>
    <ExportDocDependencyProfile Condition="'$(ExportDocDependencyProfile)' == ''">full</ExportDocDependencyProfile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(ExportDocRuntimeRestore)' == 'true' and '$(RuntimeIdentifier)' != ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'eng', 'nuget-runtime-locks', '$(RuntimeIdentifier)', '$(MSBuildProjectName).packages.lock.json'))</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(ExportDocRuntimeRestore)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(MSBuildProjectName)' == 'ExportDocManager.Api' and '$(ExportDocDependencyProfile)' != 'full'">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'eng', 'nuget-runtime-locks', '$(RuntimeIdentifier)', '$(MSBuildProjectName).$(ExportDocDependencyProfile).packages.lock.json'))</NuGetLockFilePath>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <_ExportDocOnnxRuntimeFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">onnxruntime.dll</_ExportDocOnnxRuntimeFile>
    <_ExportDocOnnxRuntimeFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">libonnxruntime.so</_ExportDocOnnxRuntimeFile>
    <_ExportDocOnnxRuntimeFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">libonnxruntime.dylib</_ExportDocOnnxRuntimeFile>
  </PropertyGroup>
</Project>
